@page "/generar-cuota-semanal"
@using LaConcordia.DTO
@using LaConcordia.Interface
@using LaConcordia.Pagination
@inject IGenerarCuota generarCuotaRepo
@inject IDisplayMessage displayMessage

<link href="css/AdminCommon.css" rel="stylesheet" />

<div class="page-container">
    <div class="content-card">
        <div class="header-section">
            <h1 class="page-title">
                <i class="fas fa-file-invoice-dollar"></i> Generar Cuota Semanal
            </h1>
        </div>

        <div class="d-flex gap-2 mb-3" style="flex-wrap: wrap; align-items: end;">
            <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label">Año</label>
                <select class="form-control" @bind="anio">
                    <option value="">--</option>
                    @for (int a = DateTime.Now.Year - 1; a <= DateTime.Now.Year + 1; a++)
                    {
                        <option value="@a">@a</option>
                    }
                </select>
            </div>
            <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label">Mes</label>
                <select class="form-control" @bind="mes">
                    <option value="">--</option>
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m.ToString("00")">@m.ToString("00")</option>
                    }
                </select>
            </div>
            <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label">Semana</label>
                <select class="form-control" @bind="semana">
                    <option value="">--</option>
                    @for (int s = 1; s <= 5; s++)
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </div>
            <button class="btn-modern btn-secondary-modern" @onclick="Mostrar" disabled="@(!PuedeMostrar)">
                <i class="fas fa-eye"></i> Mostrar
            </button>
            <button class="btn-modern btn-primary-modern" @onclick="Generar" disabled="@(!PuedeGenerar)">
                <i class="fas fa-play"></i> Generar
            </button>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2">
            <p class="text-muted mb-0">Total de socios pendientes: <strong>@pendientes.Count</strong></p>
            <Pagination TotalItems="@pendientes.Count"
                        PageSize="@PageSize"
                        CurrentPage="@PaginaActual"
                        OnPageChanged="OnPageChangedAsync" />
        </div>

        <table class="admin-table">
            <thead>
                <tr>
                    <th>Cédula</th>
                    <th>Apellidos</th>
                    <th>Nombre</th>
                    <th>Cuota Semanal</th>
                </tr>
            </thead>
            <tbody>
                @if (pendientes.Count > 0)
                {
                    @foreach (var item in pendientesPagina)
                    {
                        <tr>
                            <td>@item.Cedula</td>
                            <td>@item.Apellidos</td>
                            <td><strong>@item.Nombre</strong></td>
                            <td>@item.Cuotaf?.ToString("0.00")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="empty-state">
                            <p>Seleccione año, mes y semana, y presione "Mostrar".</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private string anio = string.Empty;
    private string mes = string.Empty;
    private string semana = string.Empty;
    private List<PendienteCuotaDTO> pendientes = new();

    // Paginación (client-side: la lista completa ya llega del servidor de una sola vez)
    private int PaginaActual = 1;
    private int PageSize = 10;
    private List<PendienteCuotaDTO> pendientesPagina =>
        pendientes.Skip((PaginaActual - 1) * PageSize).Take(PageSize).ToList();

    private string Periodo => anio + mes;

    private bool PuedeMostrar => !string.IsNullOrEmpty(anio) && !string.IsNullOrEmpty(mes) && !string.IsNullOrEmpty(semana);
    private bool PuedeGenerar => PuedeMostrar && pendientes.Count > 0;

    private async Task Mostrar()
    {
        try
        {
            pendientes = await generarCuotaRepo.GetPendientesPorPeriodo(Periodo, semana);
            PaginaActual = 1;
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("Error al consultar pendientes: " + ex.Message);
        }
    }

    private async Task Generar()
    {
        try
        {
            var resultado = await generarCuotaRepo.GenerarCuotaSemanal(Periodo, semana);
            await displayMessage.DisplaySuccessMessage($"Período generado con éxito. Se generaron {resultado.TotalGenerados} cuotas.");
            pendientes.Clear();
            PaginaActual = 1;
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("Error al generar el período: " + ex.Message);
        }
    }

    private void OnPageChangedAsync(int nuevaPagina)
    {
        PaginaActual = nuevaPagina;
    }
}
