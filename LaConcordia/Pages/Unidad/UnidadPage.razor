@page "/unidad"
@using LaConcordia.Interface
@inject IUnidad unidadRepo
@inject IJSRuntime JS
@using LaConcordia.DTO
@using LaConcordia.Pagination
@inject IDisplayMessage displayMessage

<link href="css/AdminCommon.css" rel="stylesheet" />

<div class="page-container">
    <div class="content-card">
        <div class="header-section">
            <h1 class="page-title">
                <i class="fas fa-car"></i> Gestión de Unidades
            </h1>
            <button class="btn-modern btn-primary-modern" @onclick="AbrirModalNuevo">
                <i class="fas fa-plus"></i> Nueva Unidad
            </button>
        </div>

        <div class="d-flex gap-2 mb-3" style="flex-wrap: wrap; align-items: center;">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="Buscar por placa..." @bind="filtroPlaca" @bind:event="oninput" @bind:after="OnFiltroChanged" />
            </div>
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="Buscar por propietario..." @bind="filtroPropietario" @bind:event="oninput" @bind:after="OnFiltroChanged" />
            </div>
            <select class="form-control" style="width: 180px;" @bind="estadoFiltro" @bind:after="OnFiltroChanged">
                <option value="">Todos los Estados</option>
                <option value="a">Activo</option>
                <option value="p">Pasivo</option>
            </select>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2">
            <p class="text-muted mb-0">Total: @TotalRegistros | Página: @PaginaActual</p>
            <Pagination TotalItems="@TotalRegistros"
                        PageSize="@PageSize"
                        CurrentPage="@PaginaActual"
                        OnPageChanged="OnPageChangedAsync" />
        </div>

        <div style="overflow-x: auto;">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Unidad</th>
                        <th>Placa</th>
                        <th>Cédula</th>
                        <th>Propietario</th>
                        <th>Marca</th>
                        <th>Modelo</th>
                        <th>Año</th>
                        <th style="width: 130px;">Estado</th>
                        <th style="width: 120px; text-align: center;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (unidades is not null && unidades.Count > 0)
                    {
                        @foreach (var u in unidades)
                        {
                            <tr>
                                <td><strong>@u.Unidad1</strong></td>
                                <td>@u.Placa</td>
                                <td>@u.Idpropietario</td>
                                <td>@u.Propietario</td>
                                <td>@u.Marca</td>
                                <td>@u.Modelo</td>
                                <td>@u.Anio</td>
                                <td>
                                    @if (u.Estado == "a")
                                    {
                                        <span class="badge-modern badge-success"><i class="fas fa-check-circle"></i> Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge-modern badge-danger"><i class="fas fa-times-circle"></i> Pasivo</span>
                                    }
                                </td>
                                <td>
                                    <div class="action-buttons" style="justify-content: center;">
                                        <button class="btn-icon btn-edit" title="Editar" @onclick="() => AbrirModalEditar(u)">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn-icon btn-delete" title="Eliminar" @onclick="() => Eliminar(u)">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="empty-state">
                                <i class="fas fa-car"></i>
                                <p>No se encontraron registros.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (showModal)
{
    <div class="modal-modern" @onclick="CerrarModal">
        <div class="modal-content-modern" style="max-width: 560px;" @onclick:stopPropagation="true">
            <div class="modal-header-modern">
                <h2 class="modal-title-modern">
                    <i class="fas @(esNuevo ? "fa-plus" : "fa-edit")"></i>
                    @(esNuevo ? "Nueva Unidad" : "Editar Unidad")
                </h2>
                <button type="button" class="btn-close-modern" @onclick="CerrarModal">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="modal-body-modern">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Unidad <span class="text-danger">*</span></label>
                            <input class="form-control" @bind="unidadSeleccionada.Unidad1" placeholder="Unidad" disabled="@(!esNuevo)" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Cédula Propietario</label>
                            <input class="form-control" @bind="unidadSeleccionada.Idpropietario" placeholder="Cédula" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Marca</label>
                            <input class="form-control" @bind="unidadSeleccionada.Marca" placeholder="Marca" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Año</label>
                            <select class="form-control" @bind="unidadSeleccionada.Anio">
                                <option value="">-- Seleccione Año --</option>
                                @foreach (var anio in AniosDisponibles)
                                {
                                    <option value="@anio">@anio</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Estado</label>
                            <select class="form-control" @bind="unidadSeleccionada.Estado">
                                <option value="a">Activo</option>
                                <option value="p">Pasivo</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Placa <span class="text-danger">*</span></label>
                            <input class="form-control" @bind="unidadSeleccionada.Placa" placeholder="Placa" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Propietario</label>
                            <input class="form-control" @bind="unidadSeleccionada.Propietario" placeholder="Propietario" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Modelo</label>
                            <input class="form-control" @bind="unidadSeleccionada.Modelo" placeholder="Modelo" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Color</label>
                            <input class="form-control" @bind="unidadSeleccionada.Color" placeholder="Color" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer-modern">
                <button type="button" class="btn-modern btn-secondary-modern" @onclick="CerrarModal">
                    <i class="fas fa-times"></i> Cancelar
                </button>
                <button type="button" class="btn-modern btn-primary-modern" @onclick="Guardar" disabled="@(!PuedeGuardar)">
                    <i class="fas fa-save"></i> Guardar
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<UnidadDTO> todasLasUnidades = new();
    private List<UnidadDTO> unidades = new();
    private UnidadDTO unidadSeleccionada = new();
    private bool esNuevo = false;
    private bool showModal = false;

    private static readonly List<int> AniosDisponibles = Enumerable
        .Range(1980, DateTime.Now.Year - 1980 + 2)
        .OrderByDescending(a => a)
        .ToList();

    private string filtroPlaca = "";
    private string filtroPropietario = "";
    private string estadoFiltro = "";

    private int PaginaActual = 1;
    private int PageSize = 10;
    private int TotalRegistros = 0;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    // Trae todas las unidades del servidor una sola vez; el filtro y la
    // paginacion se resuelven despues en memoria, sin volver a golpear la API/BD.
    private async Task CargarAsync()
    {
        todasLasUnidades = await unidadRepo.GetUnidadInfoAll() ?? new();
        AplicarFiltro();
    }

    private void AplicarFiltro()
    {
        IEnumerable<UnidadDTO> query = todasLasUnidades;

        if (!string.IsNullOrWhiteSpace(filtroPlaca))
            query = query.Where(u => u.Placa != null &&
                u.Placa.Contains(filtroPlaca, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrWhiteSpace(filtroPropietario))
            query = query.Where(u => u.Propietario != null &&
                u.Propietario.Contains(filtroPropietario, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrEmpty(estadoFiltro))
            query = query.Where(u => u.Estado == estadoFiltro);

        var filtradas = query.ToList();
        TotalRegistros = filtradas.Count;

        unidades = filtradas
            .Skip((PaginaActual - 1) * PageSize)
            .Take(PageSize)
            .ToList();
    }

    private void OnFiltroChanged()
    {
        PaginaActual = 1;
        AplicarFiltro();
    }

    private void AbrirModalNuevo()
    {
        unidadSeleccionada = new UnidadDTO { Estado = "a" };
        esNuevo = true;
        showModal = true;
    }

    private void AbrirModalEditar(UnidadDTO u)
    {
        unidadSeleccionada = new UnidadDTO
            {
                Unidad1 = u.Unidad1,
                Placa = u.Placa,
                Propietario = u.Propietario,
                Marca = u.Marca,
                Modelo = u.Modelo,
                Anio = u.Anio,
                Estado = u.Estado,
                Color = u.Color,
                Idpropietario = u.Idpropietario
            };
        esNuevo = false;
        showModal = true;
    }

    private void CerrarModal()
    {
        showModal = false;
        unidadSeleccionada = new();
        esNuevo = false;
    }

    private async Task Guardar()
    {
        try
        {
            if (esNuevo)
                await unidadRepo.InsertUnidad(unidadSeleccionada);
            else
                await unidadRepo.UpdateUnidad(unidadSeleccionada);

            await displayMessage.DisplaySuccessMessage(esNuevo ? "Unidad creada correctamente." : "Unidad actualizada correctamente.");
            CerrarModal();
            await CargarAsync();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error al guardar: {ex.Message}");
        }
    }

    private async Task Eliminar(UnidadDTO u)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", $"¿Está seguro de eliminar la unidad \"{u.Unidad1}\"?");
        if (confirm)
        {
            await unidadRepo.DeleteUnidadById(u.Unidad1);
            await CargarAsync();
        }
    }

    private void OnPageChangedAsync(int nuevaPagina)
    {
        PaginaActual = nuevaPagina;
        AplicarFiltro();
    }

    private bool PuedeGuardar => !string.IsNullOrWhiteSpace(unidadSeleccionada.Unidad1) && !string.IsNullOrWhiteSpace(unidadSeleccionada.Placa);
}
