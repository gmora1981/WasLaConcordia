@page "/cambiar-password"
@using LaConcordia.Model
@using LaConcordia.Repository
@attribute [Authorize]
@inject IAccountsRepository accountsRepository
@inject IDisplayMessage displayMessage
@inject NavigationManager NavManager

<div class="page-container">
    <div class="content-card" style="max-width: 480px; margin: 2rem auto;">
        <div class="header-section">
            <h1 class="page-title">
                <i class="fas fa-key"></i> Cambiar Contraseña
            </h1>
        </div>

        <EditForm Model="modelo" OnValidSubmit="Guardar">
            <DataAnnotationsValidator />

            <div class="form-group mb-3">
                <label class="form-label">Contraseña actual</label>
                <InputText type="password" class="form-control" @bind-Value="modelo.CurrentPassword" />
                <ValidationMessage For="@(() => modelo.CurrentPassword)" class="validation-message" />
            </div>

            <div class="form-group mb-3">
                <label class="form-label">Nueva contraseña</label>
                <InputText type="password" class="form-control" @bind-Value="modelo.NewPassword" />
                <ValidationMessage For="@(() => modelo.NewPassword)" class="validation-message" />
            </div>

            <div class="form-group mb-3">
                <label class="form-label">Confirmar nueva contraseña</label>
                <InputText type="password" class="form-control" @bind-Value="modelo.ConfirmPassword" />
                <ValidationMessage For="@(() => modelo.ConfirmPassword)" class="validation-message" />
            </div>

            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn-modern btn-primary-modern" disabled="@guardando">
                    @if (guardando)
                    {
                        <div class="spinner-border spinner-border-sm"></div>
                        <span style="margin-left: 0.5rem;">Guardando...</span>
                    }
                    else
                    {
                        <i class="fas fa-save"></i>
                        <span>Guardar</span>
                    }
                </button>
                <button type="button" class="btn-modern btn-secondary-modern" @onclick="Cancelar">
                    <i class="fas fa-times"></i> Cancelar
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private ChangeMyPasswordDTO modelo = new();
    private bool guardando = false;

    private async Task Guardar()
    {
        try
        {
            guardando = true;
            await accountsRepository.ChangeMyPassword(modelo);
            await displayMessage.DisplaySuccessMessage("Contraseña actualizada correctamente.");
            modelo = new ChangeMyPasswordDTO();
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("Error al cambiar la contraseña: " + ex.Message);
        }
        finally
        {
            guardando = false;
        }
    }

    private void Cancelar()
    {
        NavManager.NavigateTo("/");
    }
}
