@page "/dashboard"
@using LaConcordia.DTO
@using LaConcordia.Interface
@inject IPedido pedidoRepo
@inject IDisplayMessage displayMessage

<link href="css/AdminCommon.css" rel="stylesheet" />

<div class="page-container">
    <div class="content-card">
        <div class="header-section">
            <h1 class="page-title">
                <i class="fas fa-chart-bar"></i> Dashboard
            </h1>
        </div>

        <div class="d-flex gap-2 mb-3" style="flex-wrap: wrap; align-items: end;">
            <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label">Desde</label>
                <input type="date" class="form-control" @bind="desde" @bind:after="Cargar" />
            </div>
            <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label">Hasta</label>
                <input type="date" class="form-control" @bind="hasta" @bind:after="Cargar" />
            </div>
        </div>

        <h5 class="text-center mb-4">Total de Ingresos de Carreras Asignadas</h5>

        @if (cargando)
        {
            <div class="text-center text-muted py-5">Cargando…</div>
        }
        else if (datos.Count == 0)
        {
            <div class="empty-state">
                <i class="fas fa-chart-bar"></i>
                <p>No hay pedidos registrados en el rango seleccionado.</p>
            </div>
        }
        else
        {
            <div style="display: flex; align-items: flex-end; height: 320px; position: relative; padding-left: 55px; margin-top: 10px;">
                @for (int i = 0; i <= 4; i++)
                {
                    var valor = MaxEje * i / 4;
                    var bottomPct = i * 25;
                    <div style="position: absolute; left: 0; right: 0; bottom: @(bottomPct)%; border-top: 1px dashed #e5e7eb;">
                        <span style="position: absolute; left: -50px; top: -8px; font-size: 0.7rem; color: #6c757d; width: 42px; text-align: right;">@valor</span>
                    </div>
                }
                <div style="position: absolute; left: 55px; right: 0; bottom: 0; top: 0; border-left: 2px solid #333; border-bottom: 2px solid #333;"></div>

                <div style="display: flex; align-items: flex-end; gap: 2rem; height: 100%; width: 100%; padding-left: 20px; position: relative;">
                    @for (int i = 0; i < datos.Count; i++)
                    {
                        var alturaPct = MaxEje == 0 ? 0 : (datos[i].Cantidad * 100.0 / MaxEje);
                        <div style="display: flex; flex-direction: column; align-items: center; flex: 1; height: 100%; justify-content: flex-end;">
                            <span style="font-size: 0.75rem; font-weight: 600; margin-bottom: 3px;">@datos[i].Cantidad</span>
                            <div style="width: 60%; height: @(alturaPct)%; background: @ColorUsuario(i); border-radius: 3px 3px 0 0;"></div>
                        </div>
                    }
                </div>
            </div>

            <div style="display: flex; gap: 2rem; padding-left: 75px; margin-top: 6px;">
                @for (int i = 0; i < datos.Count; i++)
                {
                    <div style="flex: 1; text-align: center; font-size: 0.8rem; font-weight: 600;">@datos[i].Usuario</div>
                }
            </div>
            <p class="text-center text-muted mt-1" style="font-size: 0.8rem;">USUARIO</p>

            <div class="d-flex gap-3 mt-3 justify-content-center flex-wrap">
                @for (int i = 0; i < datos.Count; i++)
                {
                    <div class="d-flex align-items-center gap-1">
                        <span style="width: 14px; height: 14px; background: @ColorUsuario(i); display: inline-block; border-radius: 2px;"></span>
                        <span style="font-size: 0.8rem;">@datos[i].Usuario</span>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private DateTime desde = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime hasta = DateTime.Today;
    private List<PedidosPorUsuarioDTO> datos = new();
    private bool cargando = false;

    private static readonly string[] Paleta =
    {
        "#2f5496", "#f59e0b", "#16a34a", "#7c3aed", "#dc2626", "#0891b2", "#db2777", "#65a30d"
    };

    private int MaxEje => datos.Count == 0
        ? 100
        : (int)(Math.Ceiling((datos.Max(x => x.Cantidad) + 1) / 100.0) * 100);

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    private async Task Cargar()
    {
        if (desde > hasta)
        {
            await displayMessage.DisplayErrorMessage("La fecha 'Desde' no puede ser posterior a 'Hasta'.");
            return;
        }

        cargando = true;
        try
        {
            datos = await pedidoRepo.GetCantidadPedidosPorUsuario(desde, hasta);
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("Error al cargar el dashboard: " + ex.Message);
        }
        finally
        {
            cargando = false;
        }
    }

    private string ColorUsuario(int index) => Paleta[index % Paleta.Length];
}
