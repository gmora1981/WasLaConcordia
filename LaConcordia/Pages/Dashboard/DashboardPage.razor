@page "/dashboard"
@using LaConcordia.DTO
@using LaConcordia.Interface
@inject IPedido pedidoRepo
@inject IOrdenPago ordenPagoRepo
@inject IPagos pagosRepo
@inject IBalance balanceRepo
@inject IDisplayMessage displayMessage

<link href="css/AdminCommon.css" rel="stylesheet" />

<div class="page-container">
    <div class="content-card">

        <div class="dash-header">
            <div>
                <h1 class="dash-title">Dashboard Overview</h1>
                <p class="dash-subtitle">Métricas operativas y resumen financiero.</p>
            </div>
            <div class="dash-date-pill">
                <i class="fas fa-calendar-alt"></i>
                <span>Desde:</span>
                <input type="date" @bind="desde" @bind:after="Cargar" />
                <span>-</span>
                <span>Hasta:</span>
                <input type="date" @bind="hasta" @bind:after="Cargar" />
            </div>
        </div>

        @if (cargando)
        {
            <div class="text-center text-muted py-5">Cargando…</div>
        }
        else
        {
            <div class="dash-kpi-row">
                <div class="dash-kpi-card">
                    <div class="dash-kpi-icon bg-blue"><i class="fas fa-route"></i></div>
                    <div>
                        <div class="dash-kpi-label">Total Carreras</div>
                        <div class="dash-kpi-value">
                            @totalCarreras.ToString("N0")
                            @if (variacionCarreras.HasValue)
                            {
                                <span class="dash-kpi-badge @(variacionCarreras.Value >= 0 ? "up" : "down")">
                                    <i class="fas fa-arrow-@(variacionCarreras.Value >= 0 ? "up" : "down")"></i>
                                    @Math.Abs(variacionCarreras.Value).ToString("0")%
                                </span>
                            }
                        </div>
                    </div>
                </div>
                <div class="dash-kpi-card">
                    <div class="dash-kpi-icon bg-red"><i class="fas fa-exclamation-circle"></i></div>
                    <div>
                        <div class="dash-kpi-label">Vouchers Pendientes</div>
                        <div class="dash-kpi-value text-red">$@resumenVoucher.MontoPendiente.ToString("N0")</div>
                    </div>
                </div>
                <div class="dash-kpi-card">
                    <div class="dash-kpi-icon bg-blue"><i class="fas fa-wallet"></i></div>
                    <div>
                        <div class="dash-kpi-label">Balance Total</div>
                        <div class="dash-kpi-value">$@((balance?.Total ?? 0).ToString("N0"))</div>
                    </div>
                </div>
            </div>

            <div class="dash-grid-main">
                <div class="dash-card">
                    <h3>Total de Ingresos de Carreras Asignadas</h3>
                    @if (datos.Count == 0)
                    {
                        <div class="empty-state">
                            <i class="fas fa-chart-bar"></i>
                            <p>No hay pedidos registrados en el rango seleccionado.</p>
                        </div>
                    }
                    else
                    {
                        <BarraPixeles Etiquetas="@(datos.Select(x => x.Usuario).ToList())"
                                      Valores="@(datos.Select(x => (double)x.Cantidad).ToList())" />
                    }
                </div>

                <div class="dash-card">
                    <h3>Vouchers Emitidos</h3>
                    <div class="dash-list-row">
                        <span class="dash-dot bg-blue"></span>
                        <div class="dash-list-info">
                            <div class="dash-list-label">Total</div>
                            <div class="dash-list-sub">@resumenVoucher.Total uds</div>
                        </div>
                        <div class="dash-list-value">$@resumenVoucher.MontoTotal.ToString("N0")</div>
                    </div>
                    <div class="dash-list-row">
                        <span class="dash-dot bg-green"></span>
                        <div class="dash-list-info">
                            <div class="dash-list-label">Procesados</div>
                            <div class="dash-list-sub">@resumenVoucher.Procesados uds</div>
                        </div>
                        <div class="dash-list-value text-green">$@resumenVoucher.MontoProcesado.ToString("N0")</div>
                    </div>
                    <div class="dash-list-row">
                        <span class="dash-dot bg-red"></span>
                        <div class="dash-list-info">
                            <div class="dash-list-label">Pendientes</div>
                            <div class="dash-list-sub">@resumenVoucher.Pendientes uds</div>
                        </div>
                        <div class="dash-list-value text-red">$@resumenVoucher.MontoPendiente.ToString("N0")</div>
                    </div>
                </div>
            </div>

            <div class="dash-grid-secondary">
                <div class="dash-card">
                    <h3>Cobros de Monitoria</h3>
                    <div class="dash-list-row">
                        <span class="dash-dot bg-blue"></span>
                        <div class="dash-list-info">
                            <div class="dash-list-label">Generadas</div>
                            <div class="dash-list-sub">@resumenMonitoria.CuotasGeneradas uds</div>
                        </div>
                        <div class="dash-list-value">$@resumenMonitoria.MontoGenerado.ToString("N0")</div>
                    </div>
                    <div class="dash-list-row">
                        <span class="dash-dot bg-green"></span>
                        <div class="dash-list-info">
                            <div class="dash-list-label">Pagadas</div>
                            <div class="dash-list-sub">@resumenMonitoria.CuotasPagadas uds</div>
                        </div>
                        <div class="dash-list-value text-green">$@resumenMonitoria.MontoCobrado.ToString("N0")</div>
                    </div>
                    <div class="dash-list-row">
                        <span class="dash-dot bg-red"></span>
                        <div class="dash-list-info">
                            <div class="dash-list-label">Pendientes</div>
                            <div class="dash-list-sub">@resumenMonitoria.CuotasPendientes uds</div>
                        </div>
                        <div class="dash-list-value text-red">$@resumenMonitoria.MontoPendiente.ToString("N0")</div>
                    </div>
                </div>

                <div class="dash-card">
                    <h3>Balance por Pago</h3>
                    @if (balance == null || balance.Items.Count == 0)
                    {
                        <div class="empty-state">
                            <i class="fas fa-chart-pie"></i>
                            <p>No hay pagos registrados en el rango seleccionado.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in balance.Items.OrderByDescending(x => x.Valor))
                        {
                            var porcentaje = balance.Total == 0 ? 0 : (double)(item.Valor / balance.Total * 100);
                            <div class="dash-progress-row">
                                <div class="dash-progress-top">
                                    <span class="label">@item.FormaDePago (@porcentaje.ToString("0")%)</span>
                                    <span class="value">$@item.Valor.ToString("N0")</span>
                                </div>
                                <div class="dash-progress-track">
                                    <div class="dash-progress-fill" style="width: @(porcentaje.ToString("0.0"))%;"></div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="dash-card">
                <h3>Top 10 de las Unidades con Más Carreras</h3>
                @if (datosUnidad.Count == 0)
                {
                    <div class="empty-state">
                        <i class="fas fa-chart-bar"></i>
                        <p>No hay pedidos registrados en el rango seleccionado.</p>
                    </div>
                }
                else
                {
                    <BarraPixeles Etiquetas="@(datosUnidad.Select(x => x.Unidad).ToList())"
                                  Valores="@(datosUnidad.Select(x => (double)x.Cantidad).ToList())" />
                }
            </div>
        }
    </div>
</div>

@code {
    private DateTime desde = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime hasta = DateTime.Today;
    private List<PedidosPorUsuarioDTO> datos = new();
    private List<PedidosPorUnidadDTO> datosUnidad = new();
    private ResumenVoucherDTO resumenVoucher = new();
    private ResumenMonitoriaDTO resumenMonitoria = new();
    private BalanceResultadoDTO? balance;
    private int totalCarreras;
    private double? variacionCarreras;
    private bool cargando = false;

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    private async Task Cargar()
    {
        if (desde > hasta)
        {
            await displayMessage.DisplayErrorMessage("La fecha 'Desde' no puede ser posterior a 'Hasta'.");
            return;
        }

        cargando = true;
        try
        {
            datos = await pedidoRepo.GetCantidadPedidosPorUsuario(desde, hasta);
            datosUnidad = await pedidoRepo.GetTopUnidadesConMasCarreras(desde, hasta);
            resumenVoucher = await ordenPagoRepo.GetResumenVouchers(desde, hasta);
            resumenMonitoria = await pagosRepo.GetResumenMonitoria(desde, hasta);
            balance = await balanceRepo.GetBalance(desde, hasta);

            totalCarreras = datos.Sum(x => x.Cantidad);

            // Variacion vs. el periodo anterior de la misma duracion (mismo endpoint, rango desplazado).
            var dias = (hasta.Date - desde.Date).Days + 1;
            var hastaAnterior = desde.Date.AddDays(-1);
            var desdeAnterior = hastaAnterior.AddDays(-(dias - 1));
            var datosAnteriores = await pedidoRepo.GetCantidadPedidosPorUsuario(desdeAnterior, hastaAnterior);
            var totalAnterior = datosAnteriores.Sum(x => x.Cantidad);
            variacionCarreras = totalAnterior == 0 ? null : (double)(totalCarreras - totalAnterior) / totalAnterior * 100;
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("Error al cargar el dashboard: " + ex.Message);
        }
        finally
        {
            cargando = false;
        }
    }
}
