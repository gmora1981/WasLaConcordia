@page "/cargo"
@using LaConcordia.DTO
@using LaConcordia.Interface
@using LaConcordia.Pagination
@inject ICargo cargoRepo
@inject IJSRuntime JS
@inject IDisplayMessage displayMessage

<link href="css/AdminCommon.css" rel="stylesheet" />

<div class="page-container">
    <div class="content-card">
        <div class="header-section">
            <h1 class="page-title">
                <i class="fas fa-briefcase"></i> Gestión de Cargos
            </h1>
            <button class="btn-modern btn-primary-modern" @onclick="AbrirModalNuevo">
                <i class="fas fa-plus"></i> Nuevo Cargo
            </button>
        </div>

        <!-- Filtros -->
        <div class="d-flex gap-2 mb-3" style="flex-wrap: wrap; align-items: center;">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="Buscar por nombre..." @bind="filtroBusqueda" @bind:event="oninput" @bind:after="OnFiltroChanged" />
            </div>
            <select class="form-control" style="width: 180px;" @bind="estadoFiltro" @bind:after="BuscarCargos">
                <option value="">Todos los Estados</option>
                <option value="a">Activo</option>
                <option value="i">Inactivo</option>
            </select>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2">
            <p class="text-muted mb-0">Total: @TotalRegistros | Página: @PaginaActual</p>
            <Pagination TotalItems="@TotalRegistros"
                        PageSize="@PageSize"
                        CurrentPage="@PaginaActual"
                        OnPageChanged="OnPageChangedAsync" />
        </div>

        <table class="admin-table">
            <thead>
                <tr>
                    <th style="width: 70px;">#</th>
                    <th>Nombre</th>
                    <th style="width: 130px;">Estado</th>
                    <th style="width: 120px; text-align: center;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (listaCargos != null && listaCargos.Count > 0)
                {
                    @foreach (var cargo in listaCargos)
                    {
                        <tr>
                            <td style="color: #7f8c8d;">@cargo.Idcargo</td>
                            <td><strong>@cargo.Cargo1</strong></td>
                            <td>
                                @if (cargo.Estado == "a")
                                {
                                    <span class="badge-modern badge-success"><i class="fas fa-check-circle"></i> Activo</span>
                                }
                                else
                                {
                                    <span class="badge-modern badge-danger"><i class="fas fa-times-circle"></i> Inactivo</span>
                                }
                            </td>
                            <td>
                                <div class="action-buttons" style="justify-content: center;">
                                    <button class="btn-icon btn-edit" title="Editar" @onclick="() => AbrirModalEditar(cargo)">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn-icon btn-delete" title="Eliminar" @onclick="() => EliminarCargo(cargo)">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="empty-state">
                            <i class="fas fa-briefcase"></i>
                            <p>No se encontraron cargos.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Nuevo/Editar -->
@if (showModal)
{
    <div class="modal-modern" @onclick="CerrarModal">
        <div class="modal-content-modern" style="max-width: 480px;" @onclick:stopPropagation="true">
            <div class="modal-header-modern">
                <h2 class="modal-title-modern">
                    <i class="fas @(esNuevo ? "fa-plus" : "fa-edit")"></i>
                    @(esNuevo ? "Nuevo Cargo" : "Editar Cargo")
                </h2>
                <button type="button" class="btn-close-modern" @onclick="CerrarModal">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="modal-body-modern">
                <div class="form-group">
                    <label class="form-label">Nombre <span class="text-danger">*</span></label>
                    <input class="form-control" @bind="cargoSeleccionado.Cargo1" placeholder="Ej: Chofer" />
                </div>
                <div class="form-group">
                    <label class="form-label">Estado</label>
                    <select class="form-control" @bind="cargoSeleccionado.Estado">
                        <option value="a">Activo</option>
                        <option value="i">Inactivo</option>
                    </select>
                </div>
            </div>

            <div class="modal-footer-modern">
                <button type="button" class="btn-modern btn-secondary-modern" @onclick="CerrarModal">
                    <i class="fas fa-times"></i> Cancelar
                </button>
                <button type="button" class="btn-modern btn-primary-modern" @onclick="GuardarCambios" disabled="@(!PuedeGuardar)">
                    <i class="fas fa-save"></i> Guardar
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<CargoDTO> todosLosCargos = new();
    private List<CargoDTO> listaCargos = new();
    private CargoDTO cargoSeleccionado = new();
    private string filtroBusqueda = string.Empty;
    private string estadoFiltro = string.Empty;

    private bool esNuevo = false;
    private bool showModal = false;
    private int PaginaActual = 1;
    private int PageSize = 8;
    private int TotalRegistros = 0;

    protected override async Task OnInitializedAsync()
    {
        await CargarTodosLosCargosAsync();
    }

    // Trae el catalogo completo del servidor una sola vez; el filtro y la
    // paginacion se resuelven despues en memoria, sin volver a golpear la API/BD.
    private async Task CargarTodosLosCargosAsync()
    {
        try
        {
            todosLosCargos = await cargoRepo.GetCargoInfoAll() ?? new();
            AplicarFiltro();
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("Error al cargar los cargos: " + ex.Message);
        }
    }

    private void AplicarFiltro()
    {
        IEnumerable<CargoDTO> query = todosLosCargos;

        if (!string.IsNullOrWhiteSpace(filtroBusqueda))
            query = query.Where(c => c.Cargo1 != null &&
                c.Cargo1.Contains(filtroBusqueda, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrEmpty(estadoFiltro))
            query = query.Where(c => c.Estado == estadoFiltro);

        var filtrados = query.ToList();
        TotalRegistros = filtrados.Count;

        listaCargos = filtrados
            .Skip((PaginaActual - 1) * PageSize)
            .Take(PageSize)
            .ToList();
    }

    private void OnFiltroChanged()
    {
        PaginaActual = 1;
        AplicarFiltro();
    }

    private void BuscarCargos()
    {
        PaginaActual = 1;
        AplicarFiltro();
    }

    private void AbrirModalNuevo()
    {
        cargoSeleccionado = new CargoDTO { Estado = "a" };
        esNuevo = true;
        showModal = true;
    }

    private void AbrirModalEditar(CargoDTO cargo)
    {
        cargoSeleccionado = new CargoDTO
            {
                Idcargo = cargo.Idcargo,
                Cargo1 = cargo.Cargo1,
                Estado = cargo.Estado
            };
        esNuevo = false;
        showModal = true;
    }

    private void CerrarModal()
    {
        showModal = false;
        cargoSeleccionado = new CargoDTO();
    }

    private async Task GuardarCambios()
    {
        try
        {
            if (esNuevo)
                await cargoRepo.InsertCargo(cargoSeleccionado);
            else
                await cargoRepo.UpdateCargo(cargoSeleccionado);

            await displayMessage.DisplaySuccessMessage(esNuevo ? "Cargo creado correctamente." : "Cargo actualizado correctamente.");
            CerrarModal();
            await CargarTodosLosCargosAsync();
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("Error al guardar: " + ex.Message);
        }
    }

    private async Task EliminarCargo(CargoDTO cargo)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", $"¿Está seguro de eliminar el cargo \"{cargo.Cargo1}\"?");
        if (confirm)
        {
            try
            {
                await cargoRepo.DeleteCargoById(cargo.Idcargo);
                await displayMessage.DisplaySuccessMessage("Cargo eliminado correctamente.");
                await CargarTodosLosCargosAsync();
            }
            catch (Exception ex)
            {
                await displayMessage.DisplayErrorMessage("Error al eliminar: " + ex.Message);
            }
        }
    }

    private void OnPageChangedAsync(int nuevaPagina)
    {
        PaginaActual = nuevaPagina;
        AplicarFiltro();
    }

    private bool PuedeGuardar => !string.IsNullOrWhiteSpace(cargoSeleccionado.Cargo1);
}
