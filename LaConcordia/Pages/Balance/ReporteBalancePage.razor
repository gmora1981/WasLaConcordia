@page "/reporte-balance"
@using LaConcordia.DTO
@using LaConcordia.Interface
@inject IBalance balanceRepo
@inject IDisplayMessage displayMessage
@inject IJSRuntime JS

<link href="css/AdminCommon.css" rel="stylesheet" />

<div class="page-container">
    <div class="content-card">
        <div class="header-section">
            <h1 class="page-title">
                <i class="fas fa-chart-pie"></i> Reporte de Balance
            </h1>
        </div>

        <div class="d-flex gap-2 mb-3" style="flex-wrap: wrap; align-items: end;">
            <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label">Desde</label>
                <input type="date" class="form-control" @bind="fechaDesde" />
            </div>
            <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label">Hasta</label>
                <input type="date" class="form-control" @bind="fechaHasta" />
            </div>
            <button class="btn-modern btn-primary-modern" @onclick="Generar" disabled="@(fechaDesde == null || fechaHasta == null)">
                <i class="fas fa-play"></i> Generar
            </button>
            <button class="btn-modern btn-secondary-modern" @onclick="ExportarPdf" disabled="@(fechaDesde == null || fechaHasta == null)">
                <i class="fas fa-file-pdf"></i> Exportar PDF
            </button>
        </div>

        @if (resultado != null)
        {
            <p class="text-muted">
                Del @resultado.FechaDesde.ToString("dd/MM/yyyy") al @resultado.FechaHasta.ToString("dd/MM/yyyy")
            </p>

            <table class="admin-table" style="max-width: 600px;">
                <thead>
                    <tr>
                        <th>Forma de Pago</th>
                        <th>Registros</th>
                        <th>Valor</th>
                    </tr>
                </thead>
                <tbody>
                    @if (resultado.Items.Count > 0)
                    {
                        @foreach (var item in resultado.Items)
                        {
                            <tr>
                                <td>@item.FormaDePago</td>
                                <td>@item.Registros</td>
                                <td>@item.Valor.ToString("0.00")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="empty-state">
                                <p>No hay movimientos en el rango seleccionado.</p>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-bold">
                        <td colspan="2">Total</td>
                        <td>@resultado.Total.ToString("0.00")</td>
                    </tr>
                </tfoot>
            </table>
        }
    </div>
</div>

@code {
    private DateTime? fechaDesde;
    private DateTime? fechaHasta;
    private BalanceResultadoDTO? resultado;

    private async Task Generar()
    {
        if (fechaDesde == null || fechaHasta == null) return;

        try
        {
            resultado = await balanceRepo.GetBalance(fechaDesde.Value, fechaHasta.Value);
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("Error al generar el balance: " + ex.Message);
        }
    }

    private async Task ExportarPdf()
    {
        if (fechaDesde == null || fechaHasta == null) return;

        try
        {
            var pdfBytes = await balanceRepo.ExportarPdf(fechaDesde.Value, fechaHasta.Value);

            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                await displayMessage.DisplayErrorMessage("El PDF generado está vacío.");
                return;
            }

            await JS.InvokeVoidAsync("downloadFileFromByteArray", new
            {
                byteArray = pdfBytes,
                fileName = "BalanceInicial.pdf",
                contentType = "application/pdf"
            });
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("Error al exportar el balance: " + ex.Message);
        }
    }
}
