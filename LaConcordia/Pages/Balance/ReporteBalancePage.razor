@page "/reporte-balance"
@using LaConcordia.DTO
@using LaConcordia.Interface
@inject IBalance balanceRepo
@inject IDisplayMessage displayMessage

<h3>Reporte de Balance</h3>

<div class="d-flex gap-2 align-items-end mb-3">
    <div>
        <label>Desde</label>
        <input type="date" class="form-control" @bind="fechaDesde" />
    </div>
    <div>
        <label>Hasta</label>
        <input type="date" class="form-control" @bind="fechaHasta" />
    </div>
    <button class="btn btn-primary" @onclick="Generar" disabled="@(fechaDesde == null || fechaHasta == null)">Generar</button>
</div>

@if (resultado != null)
{
    <p class="text-muted">
        Del @resultado.FechaDesde.ToString("dd/MM/yyyy") al @resultado.FechaHasta.ToString("dd/MM/yyyy")
    </p>

    <table class="table table-bordered table-hover" style="max-width: 600px;">
        <thead class="table-dark">
            <tr>
                <th>Forma de Pago</th>
                <th>Registros</th>
                <th>Valor</th>
            </tr>
        </thead>
        <tbody>
            @if (resultado.Items.Count > 0)
            {
                @foreach (var item in resultado.Items)
                {
                    <tr>
                        <td>@item.FormaDePago</td>
                        <td>@item.Registros</td>
                        <td>@item.Valor.ToString("0.00")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center">No hay movimientos en el rango seleccionado.</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="fw-bold">
                <td colspan="2">Total</td>
                <td>@resultado.Total.ToString("0.00")</td>
            </tr>
        </tfoot>
    </table>
}

@code {
    private DateTime? fechaDesde;
    private DateTime? fechaHasta;
    private BalanceResultadoDTO? resultado;

    private async Task Generar()
    {
        if (fechaDesde == null || fechaHasta == null) return;

        try
        {
            resultado = await balanceRepo.GetBalance(fechaDesde.Value, fechaHasta.Value);
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("Error al generar el balance: " + ex.Message);
        }
    }
}
