@page "/control-unidades"
@using LaConcordia.DTO
@using LaConcordia.Interface
@inject IControlUnidad controlUnidadRepo
@inject IDisplayMessage displayMessage

<link href="css/AdminCommon.css" rel="stylesheet" />

<div class="page-container">
    <div class="content-card">
        <div class="header-section">
            <h1 class="page-title">
                <i class="fas fa-truck-loading"></i> Control de Unidades
            </h1>
        </div>

        <div class="d-flex gap-4 mb-2" style="flex-wrap: wrap; align-items: flex-end;">
            <div class="form-group" style="max-width: 300px; margin-bottom: 0;">
                <label class="form-label">Turno</label>
                <select class="form-control" @bind="turno">
                    <option value="">-- Seleccione --</option>
                    <option value="MAÑANA">Mañana</option>
                    <option value="TARDE">Tarde</option>
                    <option value="NOCHE">Noche</option>
                </select>
            </div>

            <div class="d-flex gap-2" style="align-items: flex-end;">
                <div class="form-group" style="margin-bottom: 0;">
                    <label class="form-label">Verificar Estado de la Unidad</label>
                    <div class="search-box">
                        <i class="fas fa-search"></i>
                        <input type="text" placeholder="N° de unidad..." @bind="unidadVerificar" @bind:event="oninput" @onkeyup="VerEstado" />
                    </div>
                </div>
                <button class="btn-modern btn-secondary-modern" @onclick="VerEstado">
                    <i class="fas fa-eye"></i> Ver Estado
                </button>
            </div>

            @if (!string.IsNullOrEmpty(unidadVerificar))
            {
                @if (estadoVerificado == "p")
                {
                    <span class="badge-modern badge-danger" style="font-size: 0.95rem;">
                        <i class="fas fa-times-circle"></i> Unidad @unidadVerificar: Fuera de Servicio
                    </span>
                }
                else if (estadoVerificado == "a")
                {
                    <span class="badge-modern badge-success" style="font-size: 0.95rem;">
                        <i class="fas fa-check-circle"></i> Unidad @unidadVerificar: En Servicio
                    </span>
                }
                else
                {
                    <span class="badge-modern badge-secondary" style="font-size: 0.95rem;">
                        No se encontró esa unidad
                    </span>
                }
            }
        </div>

        <div style="display: flex; flex-wrap: wrap; gap: 2rem;">
            <div style="flex: 1 1 400px; min-width: 320px; max-width: 100%;">
                <h5>Fuera de Servicio</h5>
                <div style="overflow-x: auto; max-width: 100%;">
                    <table class="admin-table">
                        <thead>
                            <tr><th>Unidad</th><th>Nombres</th><th>Apellidos</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var f in fueraDeServicio)
                            {
                                <tr>
                                    <td>@f.Fkunidad</td>
                                    <td>@f.Nombre</td>
                                    <td>@f.Apellidos</td>
                                    <td style="white-space: nowrap; width: 1%;">
                                        <button class="btn-icon btn-edit" title="Ingresar" @onclick="() => Ingresar(f)" disabled="@string.IsNullOrEmpty(turno)">
                                            <i class="fas fa-arrow-right"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                            @if (fueraDeServicio.Count == 0)
                            {
                                <tr><td colspan="4" class="empty-state"><p>Sin unidades fuera de servicio.</p></td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div style="flex: 1 1 400px; min-width: 320px; max-width: 100%;">
                <h5>En Servicio</h5>
                <div style="overflow-x: auto; max-width: 100%;">
                    <table class="admin-table">
                        <thead>
                            <tr><th></th><th>Unidad</th><th>Nombres</th><th>Apellidos</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var f in enServicio)
                            {
                                <tr>
                                    <td style="white-space: nowrap; width: 1%;">
                                        <button class="btn-icon btn-delete" title="Sacar" @onclick="() => Sacar(f)" disabled="@string.IsNullOrEmpty(turno)">
                                            <i class="fas fa-arrow-left"></i>
                                        </button>
                                    </td>
                                    <td>@f.Fkunidad</td>
                                    <td>@f.Nombre</td>
                                    <td>@f.Apellidos</td>
                                </tr>
                            }
                            @if (enServicio.Count == 0)
                            {
                                <tr><td colspan="4" class="empty-state"><p>Sin unidades en servicio.</p></td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<UnidadServicioDTO> fueraDeServicio = new();
    private List<UnidadServicioDTO> enServicio = new();
    private string turno = string.Empty;

    private string unidadVerificar = string.Empty;
    private string? estadoVerificado; // "a" = en servicio, "p" = fuera de servicio, null = no encontrada

    protected override async Task OnInitializedAsync()
    {
        await CargarListas();
    }

    // Busca la unidad en las listas ya cargadas (sin volver a golpear la API/BD).
    private void VerEstado()
    {
        if (string.IsNullOrWhiteSpace(unidadVerificar))
        {
            estadoVerificado = null;
            return;
        }

        if (enServicio.Any(f => string.Equals(f.Fkunidad, unidadVerificar, StringComparison.OrdinalIgnoreCase)))
        {
            estadoVerificado = "a";
        }
        else if (fueraDeServicio.Any(f => string.Equals(f.Fkunidad, unidadVerificar, StringComparison.OrdinalIgnoreCase)))
        {
            estadoVerificado = "p";
        }
        else
        {
            estadoVerificado = null;
        }
    }

    private async Task CargarListas()
    {
        fueraDeServicio = await controlUnidadRepo.GetFichaPersonalPorServicio("p");
        enServicio = await controlUnidadRepo.GetFichaPersonalPorServicio("a");
    }

    private async Task Ingresar(UnidadServicioDTO f)
    {
        if (string.IsNullOrEmpty(turno))
        {
            await displayMessage.DisplayErrorMessage("Seleccione un turno primero.");
            return;
        }

        try
        {
            await controlUnidadRepo.MoverUnidad(new MoverUnidadRequestDTO
                {
                    Unidad = f.Fkunidad,
                    Cedula = f.Cedula,
                    Turno = turno,
                    Direccion = "INGRESO"
                });
            await CargarListas();
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("Error al registrar el ingreso: " + ex.Message);
        }
    }

    private async Task Sacar(UnidadServicioDTO f)
    {
        if (string.IsNullOrEmpty(turno))
        {
            await displayMessage.DisplayErrorMessage("Seleccione un turno primero.");
            return;
        }

        try
        {
            await controlUnidadRepo.MoverUnidad(new MoverUnidadRequestDTO
                {
                    Unidad = f.Fkunidad,
                    Cedula = f.Cedula,
                    Turno = turno,
                    Direccion = "SALIDA"
                });
            await CargarListas();
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("Error al registrar la salida: " + ex.Message);
        }
    }
}
