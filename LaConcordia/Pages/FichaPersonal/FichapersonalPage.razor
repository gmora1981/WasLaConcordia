                byteArray = pdfBytes,
                fileName = "FichaCompleta.pdf",
                contentType = "application/pdf"
            });
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error al exportar PDF: {ex.Message}");
        }
    }

