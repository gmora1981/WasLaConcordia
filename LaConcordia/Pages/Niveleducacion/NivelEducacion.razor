@page "/niveleducacion"
@using LaConcordia.DTO
@using LaConcordia.Interface
@using LaConcordia.Pagination
@inject INiveleducacion niveleducacionRepo
@inject IJSRuntime JS
@inject IDisplayMessage displayMessage

<link href="css/AdminCommon.css" rel="stylesheet" />

<div class="page-container">
    <div class="content-card">
        <div class="header-section">
            <h1 class="page-title">
                <i class="fas fa-graduation-cap"></i> Gestión de Nivel de Educación
            </h1>
            <button class="btn-modern btn-primary-modern" @onclick="AbrirModalNuevo">
                <i class="fas fa-plus"></i> Nuevo Nivel
            </button>
        </div>

        <div class="d-flex gap-2 mb-3" style="flex-wrap: wrap; align-items: center;">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="Buscar por descripción..." @bind="filtroBusqueda" @bind:event="oninput" @bind:after="OnFiltroChanged" />
            </div>
            <select class="form-control" style="width: 180px;" @bind="estadoFiltro" @bind:after="OnFiltroChanged">
                <option value="">Todos los Estados</option>
                <option value="a">Activo</option>
                <option value="p">Pasivo</option>
            </select>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2">
            <p class="text-muted mb-0">Total: @TotalRegistros | Página: @PaginaActual</p>
            <Pagination TotalItems="@TotalRegistros"
                        PageSize="@PageSize"
                        CurrentPage="@PaginaActual"
                        OnPageChanged="OnPageChangedAsync" />
        </div>

        <table class="admin-table">
            <thead>
                <tr>
                    <th style="width: 70px;">#</th>
                    <th>Descripción</th>
                    <th style="width: 130px;">Estado</th>
                    <th style="width: 120px; text-align: center;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (niveles != null && niveles.Count > 0)
                {
                    @foreach (var nivel in niveles)
                    {
                        <tr>
                            <td style="color: #7f8c8d;">@nivel.Ideducacion</td>
                            <td><strong>@nivel.Descripcion</strong></td>
                            <td>
                                @if (nivel.Estado == "a")
                                {
                                    <span class="badge-modern badge-success"><i class="fas fa-check-circle"></i> Activo</span>
                                }
                                else
                                {
                                    <span class="badge-modern badge-danger"><i class="fas fa-times-circle"></i> Pasivo</span>
                                }
                            </td>
                            <td>
                                <div class="action-buttons" style="justify-content: center;">
                                    <button class="btn-icon btn-edit" title="Editar" @onclick="() => AbrirModalEditar(nivel)">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn-icon btn-delete" title="Eliminar" @onclick="() => EliminarNivel(nivel)">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="empty-state">
                            <i class="fas fa-graduation-cap"></i>
                            <p>No se encontraron registros.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (showModal)
{
    <div class="modal-modern" @onclick="CerrarModal">
        <div class="modal-content-modern" style="max-width: 480px;" @onclick:stopPropagation="true">
            <div class="modal-header-modern">
                <h2 class="modal-title-modern">
                    <i class="fas @(esNuevo ? "fa-plus" : "fa-edit")"></i>
                    @(esNuevo ? "Nuevo Nivel de Educación" : "Editar Nivel de Educación")
                </h2>
                <button type="button" class="btn-close-modern" @onclick="CerrarModal">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="modal-body-modern">
                <div class="form-group">
                    <label class="form-label">Descripción <span class="text-danger">*</span></label>
                    <input class="form-control" @bind="nivelSeleccionado.Descripcion" placeholder="Descripción" @ref="inputDescripcionRef" />
                </div>
                <div class="form-group">
                    <label class="form-label">Estado</label>
                    <select class="form-control" @bind="nivelSeleccionado.Estado">
                        <option value="a">Activo</option>
                        <option value="p">Pasivo</option>
                    </select>
                </div>
            </div>

            <div class="modal-footer-modern">
                <button type="button" class="btn-modern btn-secondary-modern" @onclick="CerrarModal">
                    <i class="fas fa-times"></i> Cancelar
                </button>
                <button type="button" class="btn-modern btn-primary-modern" @onclick="GuardarCambios" disabled="@(!PuedeGuardar)">
                    <i class="fas fa-save"></i> Guardar
                </button>
            </div>
        </div>
    </div>
}

@code {
    private ElementReference inputDescripcionRef;

    private List<NiveleducacionDTO> todosLosNiveles = new();
    private List<NiveleducacionDTO> niveles = new();
    private NiveleducacionDTO nivelSeleccionado = new();

    private string filtroBusqueda = string.Empty;
    private string estadoFiltro = string.Empty;

    private int PaginaActual = 1;
    private int PageSize = 8;
    private int TotalRegistros = 0;

    private bool esNuevo = false;
    private bool showModal = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarNivelesAsync();
    }

    // Trae todos los niveles de educacion del servidor una sola vez; el filtro y la
    // paginacion se resuelven despues en memoria, sin volver a golpear la API/BD.
    private async Task CargarNivelesAsync()
    {
        try
        {
            todosLosNiveles = await niveleducacionRepo.GetNiveleducacionAll() ?? new();
            AplicarFiltro();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error al cargar niveles de educación: {ex.Message}");
        }
    }

    private void AplicarFiltro()
    {
        IEnumerable<NiveleducacionDTO> query = todosLosNiveles;

        if (!string.IsNullOrWhiteSpace(filtroBusqueda))
            query = query.Where(n => n.Descripcion != null &&
                n.Descripcion.Contains(filtroBusqueda, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrEmpty(estadoFiltro))
            query = query.Where(n => n.Estado == estadoFiltro);

        var filtrados = query.ToList();
        TotalRegistros = filtrados.Count;

        niveles = filtrados
            .Skip((PaginaActual - 1) * PageSize)
            .Take(PageSize)
            .ToList();
    }

    private void OnFiltroChanged()
    {
        PaginaActual = 1;
        AplicarFiltro();
    }

    private void AbrirModalNuevo()
    {
        nivelSeleccionado = new NiveleducacionDTO { Estado = "a" };
        esNuevo = true;
        showModal = true;
    }

    private void AbrirModalEditar(NiveleducacionDTO nivel)
    {
        nivelSeleccionado = new NiveleducacionDTO
            {
                Ideducacion = nivel.Ideducacion,
                Descripcion = nivel.Descripcion,
                Estado = nivel.Estado
            };
        esNuevo = false;
        showModal = true;
    }

    private void CerrarModal()
    {
        showModal = false;
        nivelSeleccionado = new NiveleducacionDTO();
        esNuevo = false;
    }

    private async Task GuardarCambios()
    {
        try
        {
            if (esNuevo)
                await niveleducacionRepo.InsertNiveleducacion(nivelSeleccionado);
            else
                await niveleducacionRepo.UpdateNiveleducacion(nivelSeleccionado);

            await displayMessage.DisplaySuccessMessage(esNuevo ? "Nivel creado correctamente." : "Nivel actualizado correctamente.");
            CerrarModal();
            await CargarNivelesAsync();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error al guardar: {ex.Message}");
        }
    }

    private async Task EliminarNivel(NiveleducacionDTO nivel)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", $"¿Está seguro de eliminar \"{nivel.Descripcion}\"?");
        if (confirm)
        {
            try
            {
                await niveleducacionRepo.DeleteNiveleducacionById(nivel.Ideducacion);
                await CargarNivelesAsync();
            }
            catch (Exception ex)
            {
                await JS.InvokeVoidAsync("alert", $"Error al eliminar: {ex.Message}");
            }
        }
    }

    private void OnPageChangedAsync(int nuevaPagina)
    {
        PaginaActual = nuevaPagina;
        AplicarFiltro();
    }

    private bool PuedeGuardar => !string.IsNullOrWhiteSpace(nivelSeleccionado.Descripcion);
}
