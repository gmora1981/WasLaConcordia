@page "/empresa"
@using LaConcordia.DTO
@using LaConcordia.Interface
@using LaConcordia.Pagination
@inject IEmpresa empresaRepo
@inject IJSRuntime JS
@inject IDisplayMessage displayMessage

<link href="css/AdminCommon.css" rel="stylesheet" />

<div class="page-container">
    <div class="content-card">
        <div class="header-section">
            <h1 class="page-title">
                <i class="fas fa-building"></i> Gestión de Empresas
            </h1>
            <div class="action-buttons">
                <button class="btn-modern btn-secondary-modern" @onclick="ExportarEmpresasPdf">
                    <i class="fas fa-file-pdf"></i> Exportar PDF
                </button>
                <button class="btn-modern btn-primary-modern" @onclick="AbrirModalNuevo">
                    <i class="fas fa-plus"></i> Nueva Empresa
                </button>
            </div>
        </div>

        <div class="d-flex gap-2 mb-3" style="flex-wrap: wrap; align-items: center;">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="Buscar por Razón Social..." @bind="razonBusqueda" @bind:event="oninput" @bind:after="OnFiltroChanged" />
            </div>
            <select class="form-control" style="width: 180px;" @bind="estadoFiltro" @bind:after="OnFiltroChanged">
                <option value="">Todos los Estados</option>
                <option value="a">Activo</option>
                <option value="p">Pasivo</option>
            </select>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2">
            <p class="text-muted mb-0">Total: @TotalUsuarios | Página: @PaginaActual</p>
            <Pagination TotalItems="@TotalUsuarios"
                        PageSize="@PageSize"
                        CurrentPage="@PaginaActual"
                        OnPageChanged="OnPageChangedAsync" />
        </div>

        <table class="admin-table">
            <thead>
                <tr>
                    <th>RUC</th>
                    <th>Razón Social</th>
                    <th>Dirección</th>
                    <th>Teléfono</th>
                    <th style="width: 130px;">Estado</th>
                    <th style="width: 120px; text-align: center;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (empresas != null && empresas.Count > 0)
                {
                    @foreach (var empresa in empresas)
                    {
                        <tr>
                            <td style="color: #7f8c8d;">@empresa.Ruc</td>
                            <td><strong>@empresa.Razonsocial</strong></td>
                            <td>@empresa.Direccion</td>
                            <td>@empresa.Telefono</td>
                            <td>
                                @if (empresa.Estado == "a")
                                {
                                    <span class="badge-modern badge-success"><i class="fas fa-check-circle"></i> Activo</span>
                                }
                                else
                                {
                                    <span class="badge-modern badge-danger"><i class="fas fa-times-circle"></i> Pasivo</span>
                                }
                            </td>
                            <td>
                                <div class="action-buttons" style="justify-content: center;">
                                    <button class="btn-icon btn-edit" title="Editar" @onclick="() => AbrirModalEditar(empresa)">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn-icon btn-delete" title="Eliminar" @onclick="() => EliminarEmpresa(empresa)">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="empty-state">
                            <i class="fas fa-building"></i>
                            <p>No se encontraron empresas.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (showModal)
{
    <div class="modal-modern" @onclick="CerrarModal">
        <div class="modal-content-modern" style="max-width: 520px;" @onclick:stopPropagation="true">
            <div class="modal-header-modern">
                <h2 class="modal-title-modern">
                    <i class="fas @(esNuevo ? "fa-plus" : "fa-edit")"></i>
                    @(esNuevo ? "Nueva Empresa" : "Editar Empresa")
                </h2>
                <button type="button" class="btn-close-modern" @onclick="CerrarModal">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="modal-body-modern">
                <div class="form-group">
                    <label class="form-label">RUC <span class="text-danger">*</span></label>
                    <input class="form-control" @bind="empresaSeleccionada.Ruc" placeholder="RUC" disabled="@(!esNuevo)" @ref="inputTipoLicenciaRef" />
                </div>
                <div class="form-group">
                    <label class="form-label">Razón Social</label>
                    <input class="form-control" @bind="empresaSeleccionada.Razonsocial" placeholder="Razón Social" />
                </div>
                <div class="form-group">
                    <label class="form-label">Dirección</label>
                    <input class="form-control" @bind="empresaSeleccionada.Direccion" placeholder="Dirección" />
                </div>
                <div class="form-group">
                    <label class="form-label">Teléfono</label>
                    <input class="form-control" @bind="empresaSeleccionada.Telefono" placeholder="Teléfono" />
                </div>
                <div class="form-group">
                    <label class="form-label">Estado</label>
                    <select class="form-control" @bind="empresaSeleccionada.Estado">
                        <option value="a">Activo</option>
                        <option value="p">Pasivo</option>
                    </select>
                </div>
            </div>

            <div class="modal-footer-modern">
                <button type="button" class="btn-modern btn-secondary-modern" @onclick="CerrarModal">
                    <i class="fas fa-times"></i> Cancelar
                </button>
                <button type="button" class="btn-modern btn-primary-modern" @onclick="GuardarCambios" disabled="@(!PuedeGuardar)">
                    <i class="fas fa-save"></i> Guardar
                </button>
            </div>
        </div>
    </div>
}

@code {
    //para focus al dar nuevo
    private ElementReference inputTipoLicenciaRef;
    private List<EmpresaDTO> todasLasEmpresas = new();
    private List<EmpresaDTO> empresas = new();
    private EmpresaDTO empresaSeleccionada = new();
    private string razonBusqueda = string.Empty;
    private string estadoFiltro = "a";
    private bool esNuevo = false;
    private bool showModal = false;

    private int PaginaActual = 1;
    private int PageSize = 8;
    private int TotalUsuarios = 0;

    protected override async Task OnInitializedAsync()
    {
        await CargarEmpresasAsync();
    }

    // Trae todas las empresas del servidor una sola vez; el filtro y la
    // paginacion se resuelven despues en memoria, sin volver a golpear la API/BD.
    private async Task CargarEmpresasAsync()
    {
        try
        {
            todasLasEmpresas = await empresaRepo.GetEmpresaInfoAll() ?? new();
            AplicarFiltro();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error al cargar empresas: {ex.Message}");
        }
    }

    private void AplicarFiltro()
    {
        IEnumerable<EmpresaDTO> query = todasLasEmpresas;

        if (!string.IsNullOrWhiteSpace(razonBusqueda))
            query = query.Where(e => e.Razonsocial != null &&
                e.Razonsocial.Contains(razonBusqueda, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrEmpty(estadoFiltro))
            query = query.Where(e => e.Estado == estadoFiltro);

        var filtradas = query.ToList();
        TotalUsuarios = filtradas.Count;

        empresas = filtradas
            .Skip((PaginaActual - 1) * PageSize)
            .Take(PageSize)
            .ToList();
    }

    private void OnFiltroChanged()
    {
        PaginaActual = 1;
        AplicarFiltro();
    }

    private void AbrirModalNuevo()
    {
        empresaSeleccionada = new EmpresaDTO { Estado = "a" };
        esNuevo = true;
        showModal = true;
    }

    private void AbrirModalEditar(EmpresaDTO empresa)
    {
        empresaSeleccionada = new EmpresaDTO
        {
            Ruc = empresa.Ruc,
            Razonsocial = empresa.Razonsocial,
            Direccion = empresa.Direccion,
            Telefono = empresa.Telefono,
            Estado = empresa.Estado
        };
        esNuevo = false;
        showModal = true;
    }

    private void CerrarModal()
    {
        showModal = false;
        empresaSeleccionada = new EmpresaDTO();
        esNuevo = false;
    }

    private async Task GuardarCambios()
    {
        try
        {
            if (esNuevo)
                await empresaRepo.InsertEmpresa(empresaSeleccionada);
            else
                await empresaRepo.UpdateEmpresa(empresaSeleccionada);

            await displayMessage.DisplaySuccessMessage(esNuevo ? "Empresa creada correctamente." : "Empresa actualizada correctamente.");
            CerrarModal();
            await CargarEmpresasAsync();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error al guardar: {ex.Message}");
        }
    }

    private async Task EliminarEmpresa(EmpresaDTO empresa)
    {
        if (string.IsNullOrEmpty(empresa.Ruc)) return;

        bool confirm = await JS.InvokeAsync<bool>("confirm", $"¿Estás seguro de eliminar la empresa \"{empresa.Razonsocial}\"?");
        if (confirm)
        {
            await empresaRepo.DeleteEmpresaByRuc(empresa.Ruc.Trim());
            await CargarEmpresasAsync();
        }
    }

    private void OnPageChangedAsync(int nuevaPagina)
    {
        PaginaActual = nuevaPagina;
        AplicarFiltro();
    }

    //exportar pdf
    private async Task ExportarEmpresasPdf()
    {
        try
        {
            var pdfBytes = await empresaRepo.ExportarEmpresasPdfAsync(razonBusqueda, estadoFiltro);

            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                await displayMessage.DisplayErrorMessage("El PDF generado está vacío.");
                return;
            }

            await JS.InvokeVoidAsync("downloadFileFromByteArray", new
            {
                byteArray = pdfBytes,
                fileName = "EmpresasListado.pdf",
                contentType = "application/pdf"
            });
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("Error al exportar PDF: " + ex.Message);
        }
    }

    private bool PuedeGuardar => !string.IsNullOrWhiteSpace(empresaSeleccionada.Ruc);
}
