@page "/reporte-operadora"
@using LaConcordia.DTO
@using LaConcordia.Interface
@inject IPedido pedidoRepo
@inject IDisplayMessage displayMessage
@inject IJSRuntime JS

<link href="css/AdminCommon.css" rel="stylesheet" />

<div class="page-container">
    <div class="content-card">
        <div class="header-section">
            <h1 class="page-title">
                <i class="fas fa-route"></i> Reporte de Solicitud de Carrera
            </h1>
        </div>

        <div class="d-flex gap-2 mb-3" style="flex-wrap: wrap; align-items: end;">
            <div class="form-group" style="width: 220px; margin-bottom: 0;">
                <label class="form-label">Operadora</label>
                <input class="form-control" list="usuariosList" placeholder="-- Todas --"
                       value="@usuarioSeleccionado" @oninput="OnUsuarioInput" />
                <datalist id="usuariosList">
                    @foreach (var u in usuarios)
                    {
                        <option value="@u">@u</option>
                    }
                </datalist>
            </div>
            <div class="form-group" style="width: 200px; margin-bottom: 0;">
                <label class="form-label">Unidad</label>
                <input class="form-control" list="unidadesList" placeholder="-- Todas --"
                       value="@unidadSeleccionada" @oninput="OnUnidadInput" />
                <datalist id="unidadesList">
                    @foreach (var u in unidades)
                    {
                        <option value="@u">@u</option>
                    }
                </datalist>
            </div>
            <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label">Desde</label>
                <input type="date" class="form-control" @bind="fechaDesde" @bind:after="Buscar" />
            </div>
            <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label">Hasta</label>
                <input type="date" class="form-control" @bind="fechaHasta" @bind:after="Buscar" />
            </div>
            <button class="btn-modern btn-secondary-modern" @onclick="ExportarPdf">
                <i class="fas fa-file-pdf"></i> Exportar PDF
            </button>
        </div>

        <p class="text-muted mb-2">Total: @lista.Count | Total Precio: @lista.Sum(x => x.Precio ?? 0).ToString("0.00")</p>

        <div style="overflow-x: auto;">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Fecha y Hora</th>
                        <th>Calle de Origen</th>
                        <th>Calle Destino</th>
                        <th>Unidad</th>
                        <th>Operadora</th>
                        <th>Precio</th>
                    </tr>
                </thead>
                <tbody>
                    @if (lista.Count > 0)
                    {
                        @foreach (var p in lista)
                        {
                            <tr>
                                <td>@p.Fecharegistro.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <td>@p.CalleOrigen</td>
                                <td>@p.CalleDestino</td>
                                <td>@p.Unidad</td>
                                <td>@p.Usuario</td>
                                <td>@p.Precio?.ToString("0.00")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="empty-state">
                                <i class="fas fa-route"></i>
                                <p>No hay pedidos registrados para el rango, la operadora y la unidad seleccionados.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<string> usuarios = new();
    private string usuarioSeleccionado = string.Empty;
    private List<string> unidades = new();
    private string unidadSeleccionada = string.Empty;
    private DateTime fechaDesde = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime fechaHasta = DateTime.Today;
    private List<PedidoOperadoraDTO> lista = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            usuarios = await pedidoRepo.GetUsuariosDisponibles();
            unidades = await pedidoRepo.GetUnidadesConPedidos();
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("Error al cargar los filtros: " + ex.Message);
        }

        await Buscar();
    }

    private async Task OnUsuarioInput(ChangeEventArgs e)
    {
        usuarioSeleccionado = e.Value?.ToString() ?? "";
        if (usuarioSeleccionado == "" || usuarios.Contains(usuarioSeleccionado))
        {
            await Buscar();
        }
    }

    private async Task OnUnidadInput(ChangeEventArgs e)
    {
        unidadSeleccionada = e.Value?.ToString() ?? "";
        if (unidadSeleccionada == "" || unidades.Contains(unidadSeleccionada))
        {
            await Buscar();
        }
    }

    private async Task Buscar()
    {
        if (fechaDesde > fechaHasta)
        {
            await displayMessage.DisplayErrorMessage("La fecha 'Desde' no puede ser posterior a 'Hasta'.");
            return;
        }

        try
        {
            lista = await pedidoRepo.GetPedidosPorOperadora(usuarioSeleccionado, fechaDesde, fechaHasta, unidadSeleccionada);
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("Error al cargar el reporte: " + ex.Message);
        }
    }

    private async Task ExportarPdf()
    {
        try
        {
            var pdfBytes = await pedidoRepo.ExportarReporteSolicitudCarreraPdf(usuarioSeleccionado, fechaDesde, fechaHasta, unidadSeleccionada);

            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                await displayMessage.DisplayErrorMessage("El PDF generado está vacío.");
                return;
            }

            await JS.InvokeVoidAsync("downloadFileFromByteArray", new
            {
                byteArray = pdfBytes,
                fileName = "ReporteSolicitudCarrera.pdf",
                contentType = "application/pdf"
            });
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("Error al exportar el reporte: " + ex.Message);
        }
    }
}
