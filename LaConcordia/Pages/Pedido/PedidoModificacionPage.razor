@page "/pedido-modificacion"
@using LaConcordia.DTO
@using LaConcordia.Interface
@using Modelo.laconcordia.Modelo.Database
@inject IPedido pedidoRepo
@inject IDisplayMessage displayMessage

<link href="css/AdminCommon.css" rel="stylesheet" />

<div class="page-container">
    <div class="content-card">
        <div class="header-section">
            <h1 class="page-title">
                <i class="fas fa-edit"></i> Modificación de Pedido
            </h1>
        </div>
        <p class="text-muted">Corrige el destino, precio, kilometraje o estado de un pedido ya registrado.</p>

        <div class="d-flex gap-2 mb-3" style="flex-wrap: wrap; align-items: center;">
            <button class="btn-modern @(modo == "estado" ? "btn-primary-modern" : "btn-secondary-modern")" @onclick="VerPorEstado">Por Estado</button>
            <button class="btn-modern @(modo == "destino" ? "btn-primary-modern" : "btn-secondary-modern")" @onclick="VerDestinoPendiente">Destino Pendiente</button>

            @if (modo == "estado")
            {
                <select class="form-control" style="width: 180px;" @bind="filtroEstado" @bind:after="VerPorEstado">
                    <option value="">-- Todos --</option>
                    <option value="ACTIVO">ACTIVO</option>
                    <option value="PROCESO">PROCESO</option>
                    <option value="FINALIZADO">FINALIZADO</option>
                    <option value="CANCELADO">CANCELADO</option>
                </select>
            }
        </div>

        <table class="admin-table">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Celular</th>
                    <th>Unidad</th>
                    <th>Conductor</th>
                    <th>Precio</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @if (lista.Count > 0)
                {
                    @foreach (var p in lista)
                    {
                        <tr @onclick="() => Seleccionar(p)" class="@(EsSeleccionado(p) ? "table-primary" : "")" style="cursor:pointer;">
                            <td>@p.Fecharegistro.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@p.Celular</td>
                            <td>@p.Unidad</td>
                            <td>@p.Conductor</td>
                            <td>@p.Precio?.ToString("0.00")</td>
                            <td>@p.Estado</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="empty-state">
                            <p>No hay pedidos para mostrar.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (seleccionado != null)
        {
            <div class="content-card" style="margin: 1rem 0 0 0; box-shadow: none; border: 1px solid #e5e7eb;">
                <h5>Editar Pedido — Celular @seleccionado.Celular</h5>

                <div class="row mb-2">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="form-label">Unidad</label>
                            <input class="form-control" value="@seleccionado.Unidad" disabled />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="form-label">Conductor</label>
                            <input class="form-control" value="@seleccionado.Conductor" disabled />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="form-label">Precio ($)</label>
                            <input type="number" step="0.01" class="form-control" @bind="precioEditado" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="form-label">Km</label>
                            <input type="number" step="0.01" class="form-control" @bind="kmEditado" />
                        </div>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Estado</label>
                            <select class="form-control" @bind="estadoEditado">
                                <option value="">-- Seleccione --</option>
                                <option value="ACTIVO">ACTIVO</option>
                                <option value="PROCESO">PROCESO</option>
                                <option value="FINALIZADO">FINALIZADO</option>
                                <option value="CANCELADO">CANCELADO</option>
                            </select>
                        </div>
                    </div>
                </div>

                <label class="form-label">Destino</label>
                <MapaSelector Lat="@destinoLat" LatChanged="@((decimal v) => destinoLat = v)"
                              Lng="@destinoLng" LngChanged="@((decimal v) => destinoLng = v)"
                              Height="280px" />

                <div class="action-buttons mt-3">
                    <button class="btn-modern btn-primary-modern" @onclick="Guardar">
                        <i class="fas fa-save"></i> Guardar
                    </button>
                    <button class="btn-modern btn-secondary-modern" @onclick="() => seleccionado = null">
                        <i class="fas fa-times"></i> Cancelar
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private string modo = "estado";
    private string filtroEstado = string.Empty;
    private List<PedidoDTO> lista = new();

    private PedidoDTO? seleccionado;
    private decimal precioEditado, kmEditado;
    private string estadoEditado = string.Empty;
    private decimal destinoLat, destinoLng;

    protected override async Task OnInitializedAsync()
    {
        await VerPorEstado();
    }

    private async Task VerPorEstado()
    {
        modo = "estado";
        try
        {
            var resultado = await pedidoRepo.GetPedidosPaginados(1, 50, null, null, filtroEstado, null, null);
            lista = resultado.Items ?? new();
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("Error al cargar pedidos: " + ex.Message);
        }
    }

    private async Task VerDestinoPendiente()
    {
        modo = "destino";
        try
        {
            lista = await pedidoRepo.GetPedidosConDestinoPendiente();
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("Error al cargar pedidos: " + ex.Message);
        }
    }

    private bool EsSeleccionado(PedidoDTO p) =>
        seleccionado != null && p.Celular == seleccionado.Celular && p.Fecharegistro == seleccionado.Fecharegistro;

    private void Seleccionar(PedidoDTO p)
    {
        seleccionado = p;
        precioEditado = p.Precio ?? 0;
        kmEditado = p.Km ?? 0;
        estadoEditado = p.Estado ?? string.Empty;
        destinoLat = p.Destinolat;
        destinoLng = p.Destinolog;
    }

    private async Task Guardar()
    {
        if (seleccionado == null) return;

        try
        {
            var actualizado = new Pedido
                {
                    Celular = seleccionado.Celular,
                    Origenlat = seleccionado.Origenlat,
                    Origenlog = seleccionado.Origenlog,
                    Destinolat = destinoLat,
                    Destinolog = destinoLng,
                    Fecharegistro = seleccionado.Fecharegistro,
                    Tiempodemora = seleccionado.Tiempodemora,
                    Ruc = seleccionado.Ruc,
                    Usuario = seleccionado.Usuario,
                    Base = seleccionado.Base,
                    Unidad = seleccionado.Unidad,
                    Ciconductor = seleccionado.Ciconductor,
                    Conductor = seleccionado.Conductor,
                    Unidadsiguiente = seleccionado.Unidadsiguiente,
                    Ciconductorsiguiente = seleccionado.Ciconductorsiguiente,
                    Conductorsiguiente = seleccionado.Conductorsiguiente,
                    Precio = precioEditado,
                    Km = kmEditado,
                    Numvoucher = seleccionado.Numvoucher,
                    Valija = seleccionado.Valija,
                    Empleado = seleccionado.Empleado,
                    Recorrido = seleccionado.Recorrido,
                    Estado = estadoEditado,
                    Autorizado = seleccionado.Autorizado
                };

            await pedidoRepo.UpdatePedido(actualizado);
            await displayMessage.DisplaySuccessMessage("El registro se actualizó con éxito.");

            seleccionado = null;
            if (modo == "estado") await VerPorEstado(); else await VerDestinoPendiente();
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("Error al actualizar: " + ex.Message);
        }
    }
}
