@page "/pedido"
@using LaConcordia.DTO
@using LaConcordia.Interface
@using LaConcordia.Pagination
@using Modelo.laconcordia.Modelo.Database
@inject IPedido pedidoRepo
@inject IPasajero pasajeroRepo
@inject IEmpresa empresaRepo
@inject IFichapersonal fichaRepo
@inject IGeocoding geocodingRepo
@inject IJSRuntime JS
@inject IDisplayMessage displayMessage

<link href="css/AdminCommon.css" rel="stylesheet" />

<div class="page-container">
    <div class="content-card">
        <div class="header-section">
            <h1 class="page-title">
                <i class="fas fa-taxi"></i> Gestión de Pedidos
            </h1>
        </div>

        <!-- Filtros de búsqueda -->
        <div class="content-card" style="margin: 0 0 1.5rem 0; box-shadow: none; border: 1px solid #e5e7eb;">
            <h5>Filtros de Búsqueda</h5>
            <div class="row">
                <div class="col-md-3 mb-2">
                    <div class="form-group">
                        <label class="form-label">Celular</label>
                        <input type="text" class="form-control" placeholder="Buscar por celular..." @bind="filtroCelular" />
                    </div>
                </div>
                <div class="col-md-3 mb-2">
                    <div class="form-group">
                        <label class="form-label">Unidad</label>
                        <input type="text" class="form-control" placeholder="Buscar por unidad..." @bind="filtroUnidad" />
                    </div>
                </div>
                <div class="col-md-3 mb-2">
                    <div class="form-group">
                        <label class="form-label">Estado</label>
                        <select class="form-control" @bind="filtroEstado">
                            <option value="">-- Todos --</option>
                            <option value="ACTIVO">ACTIVO</option>
                            <option value="PROCESO">PROCESO</option>
                            <option value="FINALIZADO">FINALIZADO</option>
                            <option value="CANCELADO">CANCELADO</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-md-3 mb-2">
                    <div class="form-group">
                        <label class="form-label">Fecha Desde</label>
                        <input type="date" class="form-control" @bind="filtroFechaDesde" />
                    </div>
                </div>
                <div class="col-md-3 mb-2">
                    <div class="form-group">
                        <label class="form-label">Fecha Hasta</label>
                        <input type="date" class="form-control" @bind="filtroFechaHasta" />
                    </div>
                </div>
                <div class="col-md-6 mb-2 d-flex align-items-end">
                    <div class="action-buttons">
                        <button class="btn-modern btn-primary-modern" @onclick="BuscarPedidos">
                            <i class="fas fa-search"></i> Buscar
                        </button>
                        <button class="btn-modern btn-secondary-modern" @onclick="LimpiarFiltros">
                            <i class="fas fa-eraser"></i> Limpiar Filtros
                        </button>
                        <button class="btn-modern btn-primary-modern" @onclick="NuevoRegistro">
                            <i class="fas fa-plus"></i> Nuevo Pedido
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2">
            <p class="text-muted mb-0">Total: @TotalRegistros | Página: @PaginaActual</p>
            <Pagination TotalItems="@TotalRegistros"
                        PageSize="@PageSize"
                        CurrentPage="@PaginaActual"
                        OnPageChanged="OnPageChangedAsync" />
        </div>

        <!-- Tabla de Pedidos -->
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Fecha Registro</th>
                    <th>Celular</th>
                    <th>Unidad</th>
                    <th>Conductor</th>
                    <th>Precio</th>
                    <th>Km</th>
                    <th>Estado</th>
                    <th>Autorizado</th>
                </tr>
            </thead>
            <tbody>
                @if (listaPedidos != null && listaPedidos.Count > 0)
                {
                    @foreach (var pedido in listaPedidos)
                    {
                        <tr @onclick="() => SeleccionarPedido(pedido)" class="@(pedido.Celular == pedidoSeleccionado?.Celular && pedido.Fecharegistro == pedidoSeleccionado?.Fecharegistro ? "table-primary" : "")" style="cursor: pointer;">
                            <td>@pedido.Fecharegistro.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@pedido.Celular</td>
                            <td>@pedido.Unidad</td>
                            <td>@pedido.Conductor</td>
                            <td>@pedido.Precio?.ToString("C")</td>
                            <td>@pedido.Km</td>
                            <td>@pedido.Estado</td>
                            <td>@pedido.Autorizado</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="empty-state">
                            <p>No se encontraron pedidos.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Formulario de detalle -->
        <div class="content-card" style="margin: 1.5rem 0 0 0; box-shadow: none; border: 1px solid #e5e7eb;">
            <h5>Detalle Pedido</h5>

            <div class="row">
                <div class="col-md-3 mb-2">
                    <div class="form-group">
                        <label class="form-label">Celular Pasajero</label>
                        <div class="input-group">
                            <input class="form-control" @bind="pedidoSeleccionado.Celular" disabled="@(!esNuevo)" />
                            <button class="btn-modern btn-secondary-modern" type="button" @onclick="BuscarPasajero" disabled="@(!esNuevo)">Buscar</button>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 mb-2">
                    <div class="form-group">
                        <label class="form-label">Nombre Pasajero</label>
                        <input class="form-control" @bind="pasajeroActual.Nombres" />
                    </div>
                </div>
                <div class="col-md-3 mb-2">
                    <div class="form-group">
                        <label class="form-label">Observación Pasajero</label>
                        <input class="form-control" @bind="pasajeroActual.Observacion" />
                    </div>
                </div>
                <div class="col-md-3 mb-2 d-flex align-items-end">
                    <button class="btn-modern btn-secondary-modern w-100" @onclick="GuardarPasajero">@(pasajeroExiste ? "Actualizar Pasajero" : "Crear Pasajero")</button>
                </div>
            </div>

            <div class="row">
                <div class="col-md-3 mb-2">
                    <div class="form-group">
                        <label class="form-label">Tiempo de Espera</label>
                        <select class="form-control" @bind="pedidoSeleccionado.Tiempodemora">
                            <option value="">-- Seleccione --</option>
                            <option value="4">4 minutos</option>
                            <option value="9">9 minutos</option>
                            <option value="12">12 minutos</option>
                            <option value="15">15 minutos</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3 mb-2">
                    <div class="form-group">
                        <label class="form-label">Estado</label>
                        <select class="form-control" @bind="pedidoSeleccionado.Estado">
                            <option value="">-- Seleccione --</option>
                            <option value="ACTIVO">ACTIVO</option>
                            <option value="PROCESO">PROCESO</option>
                            <option value="FINALIZADO">FINALIZADO</option>
                            <option value="CANCELADO">CANCELADO</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3 mb-2 d-flex align-items-end">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="chkFactura" @bind="facturarAEmpresa" />
                        <label class="form-check-label" for="chkFactura">Facturar a Empresa (Voucher)</label>
                    </div>
                </div>
                <div class="col-md-3 mb-2 d-flex align-items-end">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="chkDestino" @bind="tieneDestino" @bind:after="OnTieneDestinoChanged" />
                        <label class="form-check-label" for="chkDestino">Tiene destino definido</label>
                    </div>
                </div>
            </div>

            @if (facturarAEmpresa)
            {
                <div class="row" style="background: #f8f9fb; border: 1px solid #e5e7eb; border-radius: 8px; padding: 0.75rem; margin: 0 0 0.5rem 0;">
                    <div class="col-md-4 mb-2">
                        <div class="form-group">
                            <label class="form-label">Empresa</label>
                            <select class="form-control" value="@pedidoSeleccionado.Ruc" @onchange="OnEmpresaChanged">
                                <option value="">-- Seleccione --</option>
                                @foreach (var e in empresas)
                                {
                                    <option value="@e.Ruc">@e.Razonsocial</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3 mb-2">
                        <div class="form-group">
                            <label class="form-label">Empleado</label>
                            <input class="form-control" @bind="pedidoSeleccionado.Empleado" />
                        </div>
                    </div>
                    <div class="col-md-2 mb-2 d-flex align-items-end">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="chkValija" checked="@(pedidoSeleccionado.Valija == "s")" @onchange="OnValijaChanged" />
                            <label class="form-check-label" for="chkValija">Valija</label>
                        </div>
                    </div>
                    <div class="col-md-3 mb-2 d-flex align-items-end">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="chkAutorizado" checked="@(pedidoSeleccionado.Autorizado == "s")" @onchange="OnAutorizadoChanged" />
                            <label class="form-check-label" for="chkAutorizado">Autorizado</label>
                        </div>
                    </div>
                </div>
            }

            <div class="row">
                <div class="col-md-6 mb-2">
                    <label class="form-label">Origen</label>
                    <MapaSelector Lat="@origenLat" LatChanged="@((decimal v) => origenLat = v)"
                                  Lng="@origenLng" LngChanged="@((decimal v) => origenLng = v)"
                                  OnCoordenadasChanged="OnCoordenadasCambiaron" Height="250px" />
                </div>
                @if (tieneDestino)
                {
                    <div class="col-md-6 mb-2">
                        <label class="form-label">Destino</label>
                        <MapaSelector Lat="@destinoLat" LatChanged="@((decimal v) => destinoLat = v)"
                                      Lng="@destinoLng" LngChanged="@((decimal v) => destinoLng = v)"
                                      OnCoordenadasChanged="OnCoordenadasCambiaron" Height="250px" />
                    </div>
                }
            </div>

            <div class="row">
                <div class="col-md-3 mb-2">
                    <div class="form-group">
                        <label class="form-label">Unidad</label>
                        <input class="form-control" @bind="pedidoSeleccionado.Unidad" @bind:after="BuscarConductorUnidad" />
                    </div>
                </div>
                <div class="col-md-3 mb-2">
                    <div class="form-group">
                        <label class="form-label">C.I. Conductor</label>
                        <input class="form-control" @bind="pedidoSeleccionado.Ciconductor" />
                    </div>
                </div>
                <div class="col-md-3 mb-2">
                    <div class="form-group">
                        <label class="form-label">Conductor</label>
                        <input class="form-control" @bind="pedidoSeleccionado.Conductor" />
                    </div>
                </div>
                <div class="col-md-3 mb-2 d-flex align-items-end">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="chkBase" @bind="conRelevo" />
                        <label class="form-check-label" for="chkBase">Asignar unidad de relevo</label>
                    </div>
                </div>
            </div>

            @if (conRelevo)
            {
                <div class="row" style="background: #f8f9fb; border: 1px solid #e5e7eb; border-radius: 8px; padding: 0.75rem; margin: 0 0 0.5rem 0;">
                    <div class="col-md-4 mb-2">
                        <div class="form-group">
                            <label class="form-label">Unidad Siguiente</label>
                            <input class="form-control" @bind="pedidoSeleccionado.Unidadsiguiente" @bind:after="BuscarConductorUnidadSiguiente" />
                        </div>
                    </div>
                    <div class="col-md-4 mb-2">
                        <div class="form-group">
                            <label class="form-label">C.I. Conductor Siguiente</label>
                            <input class="form-control" @bind="pedidoSeleccionado.Ciconductorsiguiente" />
                        </div>
                    </div>
                    <div class="col-md-4 mb-2">
                        <div class="form-group">
                            <label class="form-label">Conductor Siguiente</label>
                            <input class="form-control" @bind="pedidoSeleccionado.Conductorsiguiente" />
                        </div>
                    </div>
                </div>
            }

            <div class="row">
                <div class="col-md-3 mb-2">
                    <div class="form-group">
                        <label class="form-label">Precio ($)</label>
                        <input type="number" step="0.01" class="form-control" @bind="pedidoSeleccionado.Precio" />
                    </div>
                </div>
                <div class="col-md-3 mb-2">
                    <div class="form-group">
                        <label class="form-label">Km</label>
                        <input type="number" step="0.01" class="form-control" @bind="pedidoSeleccionado.Km" />
                    </div>
                </div>
                <div class="col-md-6 mb-2">
                    <div class="form-group">
                        <label class="form-label">Recorrido (referencia)</label>
                        <input class="form-control" @bind="pedidoSeleccionado.Recorrido" />
                    </div>
                </div>
            </div>

            <div class="action-buttons mt-3">
                <button class="btn-modern btn-primary-modern" @onclick="GuardarCambios" disabled="@(!PuedeGuardar)">
                    <i class="fas fa-save"></i> Guardar
                </button>
                <button class="btn-modern btn-secondary-modern" @onclick="CancelarEdicion">
                    <i class="fas fa-times"></i> Cancelar
                </button>
            </div>
        </div>
    </div>
</div>

@if (mostrarNotificacion)
{
    <div class="modal-modern" @onclick="() => mostrarNotificacion = false">
        <div class="modal-content-modern" style="max-width: 640px;" @onclick:stopPropagation="true">
            <div class="modal-header-modern">
                <h2 class="modal-title-modern"><i class="fas fa-bell"></i> Notificación del Pedido</h2>
                <button type="button" class="btn-close-modern" @onclick="() => mostrarNotificacion = false">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="modal-body-modern">
                <h6>Mensaje para el Pasajero</h6>
                <textarea class="form-control mb-1" rows="4" readonly>@mensajePasajero</textarea>
                <div class="action-buttons mb-3">
                    <button class="btn-modern btn-secondary-modern" @onclick="() => CopiarTexto(mensajePasajero)">Copiar</button>
                    <a class="btn-modern btn-primary-modern" href="@EnlaceWhatsapp(pedidoSeleccionado.Celular, mensajePasajero)" target="_blank">Enviar por WhatsApp</a>
                </div>

                <h6>Mensaje para el Conductor</h6>
                <textarea class="form-control mb-1" rows="4" readonly>@mensajeConductor</textarea>
                <div class="action-buttons mb-3">
                    <button class="btn-modern btn-secondary-modern" @onclick="() => CopiarTexto(mensajeConductor)">Copiar</button>
                    <a class="btn-modern btn-primary-modern" href="@EnlaceWhatsapp(celularConductorNotif, mensajeConductor)" target="_blank">Enviar por WhatsApp</a>
                </div>

                <h6>Ubicación (Google Maps)</h6>
                <textarea class="form-control mb-1" rows="1" readonly>@enlaceMapa</textarea>
                <div class="action-buttons">
                    <button class="btn-modern btn-secondary-modern" @onclick="() => CopiarTexto(enlaceMapa)">Copiar</button>
                    <a class="btn-modern btn-primary-modern" href="@EnlaceWhatsapp(celularConductorNotif, enlaceMapa)" target="_blank">Enviar por WhatsApp</a>
                </div>
            </div>
            <div class="modal-footer-modern">
                <button class="btn-modern btn-secondary-modern" @onclick="() => mostrarNotificacion = false">Cerrar</button>
            </div>
        </div>
    </div>
}

@code {
    private List<PedidoDTO> listaPedidos = new();
    private Pedido pedidoSeleccionado = new();
    private PasajeroDTO pasajeroActual = new();
    private bool pasajeroExiste = false;

    private string filtroCelular = string.Empty;
    private string filtroUnidad = string.Empty;
    private string filtroEstado = string.Empty;
    private DateTime? filtroFechaDesde;
    private DateTime? filtroFechaHasta;

    private bool esNuevo = false;
    private int PaginaActual = 1;
    private int PageSize = 8;
    private int TotalRegistros = 0;

    private bool facturarAEmpresa = false;
    private bool conRelevo = false;
    private bool tieneDestino = true;
    private List<EmpresaDTO> empresas = new();

    // Coordenada placeholder para "sin destino definido todavia" (igual criterio que el sistema legado).
    private const decimal LatSinDestino = -0.380284m;
    private const decimal LngSinDestino = -91.5448445m;

    private decimal origenLat, origenLng, destinoLat, destinoLng;

    private bool mostrarNotificacion = false;
    private string mensajePasajero = string.Empty;
    private string mensajeConductor = string.Empty;
    private string enlaceMapa = string.Empty;
    private string celularConductorNotif = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        pedidoSeleccionado.Fecharegistro = DateTime.Now;
        empresas = await empresaRepo.GetEmpresaInfoAll();
        await CargarPedidosAsync();
    }

    private async Task CargarPedidosAsync()
    {
        try
        {
            var resultado = await pedidoRepo.GetPedidosPaginados(
                PaginaActual, PageSize,
                filtroCelular, filtroUnidad, filtroEstado,
                filtroFechaDesde, filtroFechaHasta);

            listaPedidos = resultado.Items ?? new();
            TotalRegistros = resultado.TotalItems;
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("Error al cargar los pedidos: " + ex.Message);
        }
    }

    private async void BuscarPedidos()
    {
        PaginaActual = 1;
        await CargarPedidosAsync();
    }

    private void LimpiarFiltros()
    {
        filtroCelular = string.Empty;
        filtroUnidad = string.Empty;
        filtroEstado = string.Empty;
        filtroFechaDesde = null;
        filtroFechaHasta = null;
        BuscarPedidos();
    }

    private void SeleccionarPedido(PedidoDTO p)
    {
        pedidoSeleccionado = new Pedido
            {
                Celular = p.Celular,
                Origenlat = p.Origenlat,
                Origenlog = p.Origenlog,
                Destinolat = p.Destinolat,
                Destinolog = p.Destinolog,
                Tiempodemora = p.Tiempodemora,
                Ruc = p.Ruc,
                Fecharegistro = p.Fecharegistro,
                Usuario = p.Usuario,
                Base = p.Base,
                Unidad = p.Unidad,
                Ciconductor = p.Ciconductor,
                Conductor = p.Conductor,
                Unidadsiguiente = p.Unidadsiguiente,
                Ciconductorsiguiente = p.Ciconductorsiguiente,
                Conductorsiguiente = p.Conductorsiguiente,
                Precio = p.Precio,
                Km = p.Km,
                Numvoucher = p.Numvoucher,
                Valija = p.Valija,
                Empleado = p.Empleado,
                Recorrido = p.Recorrido,
                Estado = p.Estado,
                Autorizado = p.Autorizado
            };

        origenLat = p.Origenlat; origenLng = p.Origenlog;
        destinoLat = p.Destinolat; destinoLng = p.Destinolog;
        tieneDestino = !(destinoLat == LatSinDestino && destinoLng == LngSinDestino);
        facturarAEmpresa = !string.IsNullOrEmpty(p.Ruc);
        conRelevo = !string.IsNullOrEmpty(p.Unidadsiguiente);
        esNuevo = false;
    }

    private void NuevoRegistro()
    {
        pedidoSeleccionado = new Pedido
            {
                Fecharegistro = DateTime.Now,
                Estado = "ACTIVO",
                Autorizado = "n",
                Valija = "n"
            };
        pasajeroActual = new PasajeroDTO();
        pasajeroExiste = false;
        facturarAEmpresa = false;
        conRelevo = false;
        tieneDestino = true;
        origenLat = 0; origenLng = 0; destinoLat = 0; destinoLng = 0;
        esNuevo = true;
    }

    private async Task BuscarPasajero()
    {
        if (string.IsNullOrWhiteSpace(pedidoSeleccionado.Celular))
            return;

        try
        {
            var encontrado = await pasajeroRepo.GetPasajeroByCelular(pedidoSeleccionado.Celular);
            if (encontrado != null)
            {
                pasajeroActual = encontrado;
                pasajeroExiste = true;
            }
            else
            {
                pasajeroActual = new PasajeroDTO { Celular = pedidoSeleccionado.Celular };
                pasajeroExiste = false;
            }
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("Error al buscar el pasajero: " + ex.Message);
        }
    }

    private async Task GuardarPasajero()
    {
        if (string.IsNullOrWhiteSpace(pedidoSeleccionado.Celular))
        {
            await displayMessage.DisplayErrorMessage("Ingrese el celular del pasajero primero.");
            return;
        }

        try
        {
            pasajeroActual.Celular = pedidoSeleccionado.Celular;
            var entidad = new Pasajero
                {
                    Celular = pasajeroActual.Celular,
                    Nombres = pasajeroActual.Nombres,
                    Observacion = pasajeroActual.Observacion,
                    Correo = pasajeroActual.Correo,
                    Sexo = pasajeroActual.Sexo,
                    Whatsapp = pasajeroActual.Whatsapp,
                    Publicidad = pasajeroActual.Publicidad
                };

            if (pasajeroExiste)
                await pasajeroRepo.UpdatePasajero(entidad);
            else
                await pasajeroRepo.InsertPasajero(entidad);

            pasajeroExiste = true;
            await displayMessage.DisplaySuccessMessage("Datos del pasajero guardados.");
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("Error al guardar el pasajero: " + ex.Message);
        }
    }

    private void OnEmpresaChanged(ChangeEventArgs e)
    {
        pedidoSeleccionado.Ruc = e.Value?.ToString();
    }

    private void OnValijaChanged(ChangeEventArgs e)
    {
        pedidoSeleccionado.Valija = ((bool)(e.Value ?? false)) ? "s" : "n";
    }

    private void OnAutorizadoChanged(ChangeEventArgs e)
    {
        pedidoSeleccionado.Autorizado = ((bool)(e.Value ?? false)) ? "s" : "n";
    }

    private void OnTieneDestinoChanged()
    {
        if (!tieneDestino)
        {
            destinoLat = LatSinDestino;
            destinoLng = LngSinDestino;
        }
    }

    private async Task BuscarConductorUnidad()
    {
        if (string.IsNullOrWhiteSpace(pedidoSeleccionado.Unidad)) return;

        var conductor = await pedidoRepo.GetConductorPorUnidad(pedidoSeleccionado.Unidad);
        if (conductor != null)
        {
            pedidoSeleccionado.Ciconductor = conductor.Cedula;
            pedidoSeleccionado.Conductor = conductor.NombreCompleto;
        }
    }

    private async Task BuscarConductorUnidadSiguiente()
    {
        if (string.IsNullOrWhiteSpace(pedidoSeleccionado.Unidadsiguiente)) return;

        var conductor = await pedidoRepo.GetConductorPorUnidad(pedidoSeleccionado.Unidadsiguiente);
        if (conductor != null)
        {
            pedidoSeleccionado.Ciconductorsiguiente = conductor.Cedula;
            pedidoSeleccionado.Conductorsiguiente = conductor.NombreCompleto;
        }
    }

    private async Task OnCoordenadasCambiaron()
    {
        pedidoSeleccionado.Origenlat = origenLat;
        pedidoSeleccionado.Origenlog = origenLng;
        pedidoSeleccionado.Destinolat = tieneDestino ? destinoLat : LatSinDestino;
        pedidoSeleccionado.Destinolog = tieneDestino ? destinoLng : LngSinDestino;

        // Si ya hay celular + origen + destino, intenta reutilizar precio/km de un pedido anterior identico.
        if (!string.IsNullOrWhiteSpace(pedidoSeleccionado.Celular) && tieneDestino
            && origenLat != 0 && destinoLat != 0
            && (pedidoSeleccionado.Precio is null or 0) && (pedidoSeleccionado.Km is null or 0))
        {
            try
            {
                var historico = await pedidoRepo.GetPrecioKmHistorico(pedidoSeleccionado.Celular, origenLat, origenLng, destinoLat, destinoLng);
                if (historico != null)
                {
                    pedidoSeleccionado.Precio = historico.Precio;
                    pedidoSeleccionado.Km = historico.Km;
                }
            }
            catch
            {
                // Sin historico o error de red: el usuario ingresa precio/km manualmente. No es bloqueante.
            }
        }
        StateHasChanged();
    }

    private async Task GuardarCambios()
    {
        try
        {
            pedidoSeleccionado.Origenlat = origenLat;
            pedidoSeleccionado.Origenlog = origenLng;
            pedidoSeleccionado.Destinolat = tieneDestino ? destinoLat : LatSinDestino;
            pedidoSeleccionado.Destinolog = tieneDestino ? destinoLng : LngSinDestino;

            if (!conRelevo)
            {
                pedidoSeleccionado.Unidadsiguiente = null;
                pedidoSeleccionado.Ciconductorsiguiente = null;
                pedidoSeleccionado.Conductorsiguiente = null;
            }

            if (!facturarAEmpresa)
            {
                pedidoSeleccionado.Ruc = null;
                pedidoSeleccionado.Empleado = null;
            }

            if (pedidoSeleccionado.Conductor != null)
                pedidoSeleccionado.Conductor = pedidoSeleccionado.Conductor.ToUpper();

            if (esNuevo)
            {
                pedidoSeleccionado.Fecharegistro = DateTime.Now;
                await pedidoRepo.InsertPedido(pedidoSeleccionado);

                // Deja guardados el pasajero y las direcciones de origen/destino para que
                // Orden de Pago pueda mostrarlas despues. Si algo de esto falla, no debe
                // impedir que el pedido ya guardado se de por exitoso.
                await GuardarPasajeroYDireccionesAsync();

                await MostrarNotificacion();
            }
            else
            {
                await pedidoRepo.UpdatePedido(pedidoSeleccionado);
            }

            await CargarPedidosAsync();
            NuevoRegistro();
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("Error al guardar: " + ex.Message);
        }
    }

    private async Task GuardarPasajeroYDireccionesAsync()
    {
        try
        {
            if (!string.IsNullOrWhiteSpace(pasajeroActual.Nombres))
            {
                pasajeroActual.Celular = pedidoSeleccionado.Celular;
                var entidad = new Pasajero
                    {
                        Celular = pasajeroActual.Celular,
                        Nombres = pasajeroActual.Nombres,
                        Observacion = pasajeroActual.Observacion,
                        Correo = pasajeroActual.Correo,
                        Sexo = pasajeroActual.Sexo,
                        Whatsapp = pasajeroActual.Whatsapp,
                        Publicidad = pasajeroActual.Publicidad
                    };

                if (pasajeroExiste)
                    await pasajeroRepo.UpdatePasajero(entidad);
                else
                    await pasajeroRepo.InsertPasajero(entidad);

                pasajeroExiste = true;
            }
        }
        catch
        {
            // No bloquea el guardado del pedido si falla el pasajero.
        }

        try
        {
            var direccionOrigen = await geocodingRepo.Reverse(origenLat, origenLng);
            await pedidoRepo.GuardarDireccion(new GuardarDireccionRequestDTO
                {
                    Celular = pedidoSeleccionado.Celular,
                    Lat = origenLat,
                    Lng = origenLng,
                    Calle = direccionOrigen
                });

            if (tieneDestino)
            {
                var direccionDestino = await geocodingRepo.Reverse(destinoLat, destinoLng);
                await pedidoRepo.GuardarDireccion(new GuardarDireccionRequestDTO
                    {
                        Celular = pedidoSeleccionado.Celular,
                        Lat = destinoLat,
                        Lng = destinoLng,
                        Calle = direccionDestino
                    });
            }
        }
        catch
        {
            // No bloquea el guardado del pedido si falla la geocodificacion/direccion.
        }
    }

    private async Task MostrarNotificacion()
    {
        celularConductorNotif = string.Empty;
        if (!string.IsNullOrWhiteSpace(pedidoSeleccionado.Ciconductor))
        {
            try
            {
                var fichaConductor = await fichaRepo.GetFichaPersonalById(pedidoSeleccionado.Ciconductor);
                celularConductorNotif = fichaConductor?.Celular ?? string.Empty;
            }
            catch
            {
                // Si no se encuentra el celular del conductor, los botones de WhatsApp del conductor
                // quedan sin numero prellenado; el usuario puede copiar el texto igual.
            }
        }

        var tiempo = pedidoSeleccionado.Tiempodemora ?? 0;

        mensajePasajero = "RADIO CLUB DE TAXI LA CONCORDIA.\n" +
            "DATOS DE LA UNIDAD ASIGNADA\n" +
            $"Conductor: {pedidoSeleccionado.Conductor}\n" +
            $"Unidad: {pedidoSeleccionado.Unidad}\n" +
            $"Tiempo de llegada: {tiempo} min\n" +
            $"Precio: {pedidoSeleccionado.Precio:0.00}\n" +
            "Por su seguridad, espere la llamada del conductor.";

        mensajeConductor = "RADIO CLUB DE TAXI LA CONCORDIA.\n" +
            "DATOS DEL PASAJERO ASIGNADO\n" +
            $"Nombre: {pasajeroActual.Nombres}\n" +
            $"Celular: +{pedidoSeleccionado.Celular}\n" +
            $"Precio: {pedidoSeleccionado.Precio:0.00}";

        enlaceMapa = $"https://www.google.com/maps/search/{origenLat},{origenLng}";

        mostrarNotificacion = true;
    }

    private string EnlaceWhatsapp(string? telefono, string mensaje)
    {
        var numero = (telefono ?? string.Empty).Trim();
        return $"https://wa.me/{numero}?text={Uri.EscapeDataString(mensaje)}";
    }

    private async Task CopiarTexto(string texto)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", texto);
        await displayMessage.DisplaySuccessMessage("Copiado al portapapeles.");
    }

    private void CancelarEdicion()
    {
        NuevoRegistro();
    }

    private async Task OnPageChangedAsync(int nuevaPagina)
    {
        PaginaActual = nuevaPagina;
        await CargarPedidosAsync();
    }

    private bool PuedeGuardar => !string.IsNullOrWhiteSpace(pedidoSeleccionado.Celular)
        && !string.IsNullOrWhiteSpace(pedidoSeleccionado.Unidad)
        && pedidoSeleccionado.Tiempodemora.HasValue
        && origenLat != 0;
}
