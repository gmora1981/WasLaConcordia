@page "/ingreso-egreso-caja"
@using LaConcordia.DTO
@using LaConcordia.Interface
@using Microsoft.AspNetCore.Components.Authorization
@inject IFlujoCaja flujoCajaRepo
@inject IDisplayMessage displayMessage
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavManager

<link href="css/AdminCommon.css" rel="stylesheet" />

<div class="page-container">
    <div class="content-card" style="max-width: 560px; margin: 0;">
        <div class="header-section">
            <h1 class="page-title">
                <i class="fas fa-cash-register"></i> Ingreso / Egreso de Caja
            </h1>
        </div>

        <div class="form-group">
            <label class="form-label">Tipo</label>
            <select class="form-control" @bind="tipo" @bind:after="OnTipoChanged">
                <option value="">-- Seleccione --</option>
                <option value="INGRESO">Ingreso</option>
                <option value="EGRESO">Egreso</option>
            </select>
        </div>

        <div class="form-group">
            <label class="form-label">Concepto</label>
            <input class="form-control" @bind="concepto" />
        </div>

        <div class="form-group">
            <label class="form-label">Observación</label>
            <input class="form-control" @bind="observacion" />
        </div>

        <div class="form-group">
            <label class="form-label">Valor</label>
            <input class="form-control" type="number" step="0.01" min="0" @bind="valor" />
        </div>

        @if (saldoAnterior.HasValue)
        {
            <p class="text-muted mb-2">Saldo actual: <strong>@saldoAnterior.Value.ToString("0.00")</strong></p>
        }

        <div class="action-buttons mt-3">
            <button class="btn-modern btn-primary-modern" @onclick="Guardar" disabled="@(!PuedeGuardar)">
                <i class="fas fa-save"></i> Guardar
            </button>
            <button class="btn-modern btn-secondary-modern" @onclick="IrAFlujoCaja">
                <i class="fas fa-list"></i> Ver Flujo de Caja
            </button>
        </div>
    </div>
</div>

@code {
    private string tipo = string.Empty;
    private string concepto = string.Empty;
    private string observacion = string.Empty;
    private decimal? valor;
    private decimal? saldoAnterior;
    private string? usuarioActual;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        usuarioActual = authState.User?.Identity?.Name;
        await CargarSaldoActual();
    }

    private async Task CargarSaldoActual()
    {
        try
        {
            var ultimo = await flujoCajaRepo.GetUltimoRegistro();
            saldoAnterior = ultimo?.Saldo ?? 0m;
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("Error al obtener el saldo actual: " + ex.Message);
        }
    }

    private void OnTipoChanged()
    {
        if (tipo == "INGRESO")
        {
            concepto = "INGRESO A CAJA";
            observacion = "EN EFECTIVO PARA PAGOS DE VOUCHER";
        }
        else if (tipo == "EGRESO")
        {
            concepto = "EGRESO DE CAJA";
            observacion = "EN EFECTIVO POR CIERRE Y CUADRE DE VOUCHER";
        }
    }

    private async Task Guardar()
    {
        try
        {
            var nuevo = new FlujoCajaDTO
                {
                    Fecha = DateTime.Now,
                    Concepto = concepto,
                    Observacion = observacion,
                    Usuario = usuarioActual,
                    Ingreso = tipo == "INGRESO" ? valor : 0,
                    Egreso = tipo == "EGRESO" ? valor : 0
                };

            await flujoCajaRepo.InsertFlujoCaja(nuevo);
            await displayMessage.DisplaySuccessMessage("El registro se guardó con éxito.");

            tipo = string.Empty;
            concepto = string.Empty;
            observacion = string.Empty;
            valor = null;
            await CargarSaldoActual();
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("Error al guardar: " + ex.Message);
        }
    }

    private bool PuedeGuardar => !string.IsNullOrEmpty(tipo) && valor.HasValue && valor.Value > 0;

    private void IrAFlujoCaja()
    {
        NavManager.NavigateTo("/flujo-caja");
    }
}
