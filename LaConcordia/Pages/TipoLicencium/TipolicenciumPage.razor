@page "/tipolicencium"
@using LaConcordia.DTO
@using LaConcordia.Interface
@using LaConcordia.Pagination
@inject ITipolicencium empresaRepo
@inject IJSRuntime JS
@inject IDisplayMessage displayMessage

<link href="css/AdminCommon.css" rel="stylesheet" />

<div class="page-container">
    <div class="content-card">
        <div class="header-section">
            <h1 class="page-title">
                <i class="fas fa-id-card"></i> Gestión de Tipos de Licencia
            </h1>
            <button class="btn-modern btn-primary-modern" @onclick="AbrirModalNuevo">
                <i class="fas fa-plus"></i> Nuevo Tipo de Licencia
            </button>
        </div>

        <div class="d-flex gap-2 mb-3" style="flex-wrap: wrap; align-items: center;">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="Buscar por Descripción..." @bind="filtroBusqueda" @bind:event="oninput" @bind:after="OnFiltroChanged" />
            </div>
            <select class="form-control" style="width: 180px;" @bind="estadoFiltro" @bind:after="OnFiltroChanged">
                <option value="">Todos los Estados</option>
                <option value="a">Activo</option>
                <option value="p">Pasivo</option>
            </select>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2">
            <p class="text-muted mb-0">Total: @TotalItems | Página: @PaginaActual</p>
            <Pagination TotalItems="@TotalItems"
                        PageSize="@PageSize"
                        CurrentPage="@PaginaActual"
                        OnPageChanged="OnPageChangedAsync" />
        </div>

        <table class="admin-table">
            <thead>
                <tr>
                    <th style="width: 70px;">#</th>
                    <th>Tipo Licencia</th>
                    <th>Profesional</th>
                    <th style="width: 130px;">Estado</th>
                    <th style="width: 120px; text-align: center;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (lista != null && lista.Count > 0)
                {
                    @foreach (var item in lista)
                    {
                        <tr>
                            <td style="color: #7f8c8d;">@item.Idtipo</td>
                            <td><strong>@item.Tipolicencia</strong></td>
                            <td>@item.Profesional</td>
                            <td>
                                @if (item.Estado == "a")
                                {
                                    <span class="badge-modern badge-success"><i class="fas fa-check-circle"></i> Activo</span>
                                }
                                else
                                {
                                    <span class="badge-modern badge-danger"><i class="fas fa-times-circle"></i> Pasivo</span>
                                }
                            </td>
                            <td>
                                <div class="action-buttons" style="justify-content: center;">
                                    <button class="btn-icon btn-edit" title="Editar" @onclick="() => AbrirModalEditar(item)">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn-icon btn-delete" title="Eliminar" @onclick="() => Eliminar(item)">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="empty-state">
                            <i class="fas fa-id-card"></i>
                            <p>No se encontraron registros.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (showModal)
{
    <div class="modal-modern" @onclick="CerrarModal">
        <div class="modal-content-modern" style="max-width: 480px;" @onclick:stopPropagation="true">
            <div class="modal-header-modern">
                <h2 class="modal-title-modern">
                    <i class="fas @(esNuevo ? "fa-plus" : "fa-edit")"></i>
                    @(esNuevo ? "Nuevo Tipo de Licencia" : "Editar Tipo de Licencia")
                </h2>
                <button type="button" class="btn-close-modern" @onclick="CerrarModal">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="modal-body-modern">
                <div class="form-group">
                    <label class="form-label">Tipo Licencia <span class="text-danger">*</span></label>
                    <input class="form-control" @bind="seleccionado.Tipolicencia" placeholder="Tipo Licencia" @ref="inputTipoLicenciaRef" />
                </div>
                <div class="form-group">
                    <label class="form-label">Profesional</label>
                    <input class="form-control" @bind="seleccionado.Profesional" placeholder="Profesional" />
                </div>
                <div class="form-group">
                    <label class="form-label">Estado</label>
                    <select class="form-control" @bind="seleccionado.Estado">
                        <option value="a">Activo</option>
                        <option value="p">Pasivo</option>
                    </select>
                </div>
            </div>

            <div class="modal-footer-modern">
                <button type="button" class="btn-modern btn-secondary-modern" @onclick="CerrarModal">
                    <i class="fas fa-times"></i> Cancelar
                </button>
                <button type="button" class="btn-modern btn-primary-modern" @onclick="Guardar" disabled="@(!PuedeGuardar)">
                    <i class="fas fa-save"></i> Guardar
                </button>
            </div>
        </div>
    </div>
}

@code {
    //para focus al dar nuevo
    private ElementReference inputTipoLicenciaRef;

    private List<TipolicenciumDTO> todosLosTipos = new();
    private List<TipolicenciumDTO> lista = new();
    private TipolicenciumDTO seleccionado = new();
    private string filtroBusqueda = string.Empty;
    private string estadoFiltro = string.Empty;
    private bool esNuevo = false;
    private bool showModal = false;

    private int PaginaActual = 1;
    private int PageSize = 8;
    private int TotalItems = 0;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    // Trae todos los tipos de licencia del servidor una sola vez; el filtro y la
    // paginacion se resuelven despues en memoria, sin volver a golpear la API/BD.
    private async Task CargarAsync()
    {
        todosLosTipos = await empresaRepo.GetTipolicenciaInfoAll() ?? new();
        AplicarFiltro();
    }

    private void AplicarFiltro()
    {
        IEnumerable<TipolicenciumDTO> query = todosLosTipos;

        if (!string.IsNullOrWhiteSpace(filtroBusqueda))
            query = query.Where(t => t.Tipolicencia != null &&
                t.Tipolicencia.Contains(filtroBusqueda, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrEmpty(estadoFiltro))
            query = query.Where(t => t.Estado == estadoFiltro);

        var filtrados = query.ToList();
        TotalItems = filtrados.Count;

        lista = filtrados
            .Skip((PaginaActual - 1) * PageSize)
            .Take(PageSize)
            .ToList();
    }

    private void OnFiltroChanged()
    {
        PaginaActual = 1;
        AplicarFiltro();
    }

    private void AbrirModalNuevo()
    {
        seleccionado = new TipolicenciumDTO { Estado = "a" };
        esNuevo = true;
        showModal = true;
    }

    private void AbrirModalEditar(TipolicenciumDTO dto)
    {
        seleccionado = new TipolicenciumDTO
            {
                Idtipo = dto.Idtipo,
                Tipolicencia = dto.Tipolicencia,
                Profesional = dto.Profesional,
                Estado = dto.Estado
            };
        esNuevo = false;
        showModal = true;
    }

    private void CerrarModal()
    {
        showModal = false;
        seleccionado = new TipolicenciumDTO();
        esNuevo = false;
    }

    private async Task Guardar()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(seleccionado.Tipolicencia))
            {
                await displayMessage.DisplayErrorMessage("El campo Tipo Licencia es obligatorio.");
                return;
            }

            seleccionado.Tipolicencia = seleccionado.Tipolicencia.ToUpper();

            if (esNuevo)
                await empresaRepo.InsertTipolicencia(seleccionado);
            else
                await empresaRepo.UpdateTipolicencia(seleccionado);

            await displayMessage.DisplaySuccessMessage(esNuevo ? "Tipo de licencia creado correctamente." : "Tipo de licencia actualizado correctamente.");
            CerrarModal();
            await CargarAsync();
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("Error al guardar: " + ex.Message);
        }
    }

    private async Task Eliminar(TipolicenciumDTO item)
    {
        if (item.Idtipo > 0)
        {
            bool confirm = await JS.InvokeAsync<bool>("confirm", $"¿Deseas eliminar \"{item.Tipolicencia}\"?");
            if (confirm)
            {
                await empresaRepo.DeleteTipolicencia(item.Idtipo);
                await CargarAsync();
            }
        }
    }

    private void OnPageChangedAsync(int nuevaPagina)
    {
        PaginaActual = nuevaPagina;
        AplicarFiltro();
    }

    private bool PuedeGuardar => !string.IsNullOrWhiteSpace(seleccionado.Tipolicencia);
}
