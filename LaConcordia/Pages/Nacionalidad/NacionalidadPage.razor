@page "/nacionalidad"
@using LaConcordia.DTO
@using LaConcordia.Interface
@using LaConcordia.Pagination
@inject INacionalidad nacionalidadRepo
@inject IJSRuntime JS

<link href="css/AdminCommon.css" rel="stylesheet" />

<div class="page-container">
    <div class="content-card">
        <div class="header-section">
            <h1 class="page-title">
                <i class="fas fa-flag"></i> Gestión de Nacionalidades
            </h1>
            <button class="btn-modern btn-primary-modern" @onclick="AbrirModalNuevo">
                <i class="fas fa-plus"></i> Nueva Nacionalidad
            </button>
        </div>

        <div class="d-flex gap-2 mb-3" style="flex-wrap: wrap; align-items: center;">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="Buscar nacionalidad..." @bind="razonBusqueda" @bind:event="oninput" @bind:after="OnFiltroChanged" />
            </div>
            <select class="form-control" style="width: 180px;" @bind="estadoFiltro" @bind:after="OnFiltroChanged">
                <option value="">Todos los Estados</option>
                <option value="a">Activo</option>
                <option value="p">Pasivo</option>
            </select>
        </div>

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="alert-modern alert-danger">
                @mensajeError
                <button type="button" class="btn-close-modern" @onclick="@(() => mensajeError = string.Empty)">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        }

        <div class="d-flex justify-content-between align-items-center mb-2">
            <p class="text-muted mb-0">Total: @TotalItems | Página: @PaginaActual</p>
            <Pagination TotalItems="@TotalItems"
                        PageSize="@PageSize"
                        CurrentPage="@PaginaActual"
                        OnPageChanged="OnPageChangedAsync" />
        </div>

        <table class="admin-table">
            <thead>
                <tr>
                    <th style="width: 70px;">#</th>
                    <th>Nacionalidad</th>
                    <th style="width: 130px;">Estado</th>
                    <th style="width: 120px; text-align: center;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (nacionalidades != null && nacionalidades.Count > 0)
                {
                    @foreach (var item in nacionalidades)
                    {
                        <tr>
                            <td style="color: #7f8c8d;">@item.Idnacionalidad</td>
                            <td><strong>@item.Nacionalidad1</strong></td>
                            <td>
                                @if (item.Estado == "a")
                                {
                                    <span class="badge-modern badge-success"><i class="fas fa-check-circle"></i> Activo</span>
                                }
                                else
                                {
                                    <span class="badge-modern badge-danger"><i class="fas fa-times-circle"></i> Pasivo</span>
                                }
                            </td>
                            <td>
                                <div class="action-buttons" style="justify-content: center;">
                                    <button class="btn-icon btn-edit" title="Editar" @onclick="() => AbrirModalEditar(item)">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn-icon btn-delete" title="Eliminar" @onclick="() => Eliminar(item)">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="empty-state">
                            <i class="fas fa-flag"></i>
                            <p>No se encontraron nacionalidades.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (showModal)
{
    <div class="modal-modern" @onclick="CerrarModal">
        <div class="modal-content-modern" style="max-width: 480px;" @onclick:stopPropagation="true">
            <div class="modal-header-modern">
                <h2 class="modal-title-modern">
                    <i class="fas @(esNuevo ? "fa-plus" : "fa-edit")"></i>
                    @(esNuevo ? "Nueva Nacionalidad" : "Editar Nacionalidad")
                </h2>
                <button type="button" class="btn-close-modern" @onclick="CerrarModal">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="modal-body-modern">
                <div class="form-group">
                    <label class="form-label">Nacionalidad <span class="text-danger">*</span></label>
                    <input class="form-control" @bind="nacionalidadSeleccionada.Nacionalidad1" placeholder="Nacionalidad" />
                </div>
                <div class="form-group">
                    <label class="form-label">Estado</label>
                    <select class="form-control" @bind="nacionalidadSeleccionada.Estado">
                        <option value="a">Activo</option>
                        <option value="p">Pasivo</option>
                    </select>
                </div>
            </div>

            <div class="modal-footer-modern">
                <button type="button" class="btn-modern btn-secondary-modern" @onclick="CerrarModal">
                    <i class="fas fa-times"></i> Cancelar
                </button>
                <button type="button" class="btn-modern btn-primary-modern" @onclick="GuardarCambios">
                    <i class="fas fa-save"></i> Guardar
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<NacionalidadDTO> todasLasNacionalidades = new();
    private List<NacionalidadDTO> nacionalidades = new();
    private NacionalidadDTO nacionalidadSeleccionada = new();
    private string razonBusqueda = string.Empty;
    private string estadoFiltro = "a";
    private bool esNuevo = false;
    private bool showModal = false;
    private string mensajeError = string.Empty;

    private int PaginaActual = 1;
    private int PageSize = 8;
    private int TotalItems = 0;

    protected override async Task OnInitializedAsync()
    {
        await CargarNacionalidadesAsync();
    }

    // Trae todas las nacionalidades del servidor una sola vez; el filtro y la
    // paginacion se resuelven despues en memoria, sin volver a golpear la API/BD.
    private async Task CargarNacionalidadesAsync()
    {
        try
        {
            todasLasNacionalidades = await nacionalidadRepo.GetNacionalidadesAll() ?? new();
            AplicarFiltro();
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cargar: {ex.Message}";
        }
    }

    private void AplicarFiltro()
    {
        IEnumerable<NacionalidadDTO> query = todasLasNacionalidades;

        if (!string.IsNullOrWhiteSpace(razonBusqueda))
            query = query.Where(n => n.Nacionalidad1 != null &&
                n.Nacionalidad1.Contains(razonBusqueda, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrEmpty(estadoFiltro))
            query = query.Where(n => n.Estado == estadoFiltro);

        var filtradas = query.ToList();
        TotalItems = filtradas.Count;

        nacionalidades = filtradas
            .Skip((PaginaActual - 1) * PageSize)
            .Take(PageSize)
            .ToList();
    }

    private void OnFiltroChanged()
    {
        PaginaActual = 1;
        AplicarFiltro();
    }

    private void AbrirModalNuevo()
    {
        nacionalidadSeleccionada = new NacionalidadDTO { Estado = "a" };
        esNuevo = true;
        showModal = true;
    }

    private void AbrirModalEditar(NacionalidadDTO item)
    {
        nacionalidadSeleccionada = new NacionalidadDTO
            {
                Idnacionalidad = item.Idnacionalidad,
                Nacionalidad1 = item.Nacionalidad1,
                Estado = item.Estado
            };
        esNuevo = false;
        showModal = true;
    }

    private void CerrarModal()
    {
        showModal = false;
        nacionalidadSeleccionada = new NacionalidadDTO();
        esNuevo = false;
        mensajeError = string.Empty;
    }

    private async Task GuardarCambios()
    {
        try
        {
            if (esNuevo)
                await nacionalidadRepo.InsertNacionalidad(nacionalidadSeleccionada);
            else
                await nacionalidadRepo.UpdateNacionalidad(nacionalidadSeleccionada);

            await CargarNacionalidadesAsync();
            CerrarModal();
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al guardar: {ex.Message}";
        }
    }

    private async Task Eliminar(NacionalidadDTO item)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", $"¿Estás seguro de eliminar \"{item.Nacionalidad1}\"?");
        if (confirm && item.Idnacionalidad > 0)
        {
            try
            {
                await nacionalidadRepo.DeleteNacionalidadById(item.Idnacionalidad);
                await CargarNacionalidadesAsync();
            }
            catch (Exception ex)
            {
                mensajeError = $"Error al eliminar: {ex.Message}";
            }
        }
    }

    private void OnPageChangedAsync(int nuevaPagina)
    {
        PaginaActual = nuevaPagina;
        AplicarFiltro();
    }
}
