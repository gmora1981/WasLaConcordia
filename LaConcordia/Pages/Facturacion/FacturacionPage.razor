@page "/facturacion"
@using LaConcordia.DTO
@using LaConcordia.Interface
@inject IOrdenPago ordenPagoRepo
@inject IEmpresa empresaRepo
@inject IDisplayMessage displayMessage
@inject IJSRuntime JS

<link href="css/AdminCommon.css" rel="stylesheet" />

<div class="page-container">
    <div class="content-card">
        <div class="header-section">
            <h1 class="page-title">
                <i class="fas fa-file-invoice"></i> Facturación
            </h1>
        </div>
        <p class="text-muted">Listado de vouchers generados por empresa.</p>

        <div class="d-flex gap-2 mb-2" style="flex-wrap: wrap; align-items: end;">
            <div class="form-group" style="max-width: 350px; margin-bottom: 0;">
                <label class="form-label">Empresa</label>
                <select class="form-control" @bind="rucSeleccionado" @bind:after="Buscar">
                    <option value="">-- Seleccione --</option>
                    @foreach (var e in empresas)
                    {
                        <option value="@e.Ruc">@e.Razonsocial</option>
                    }
                </select>
            </div>
            <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label">Hasta</label>
                <input type="date" class="form-control" @bind="fechaHasta" @bind:after="Buscar" />
            </div>
            <button class="btn-modern btn-secondary-modern" @onclick="ExportarPdf" disabled="@(string.IsNullOrEmpty(rucSeleccionado))">
                <i class="fas fa-file-pdf"></i> Exportar PDF
            </button>
        </div>

        <table class="admin-table">
            <thead>
                <tr>
                    <th>N° Voucher</th>
                    <th>Fecha</th>
                    <th>Unidad</th>
                    <th>Conductor</th>
                    <th>Precio</th>
                    <th>Monto Pagado</th>
                    <th>Estado Proceso</th>
                </tr>
            </thead>
            <tbody>
                @if (lista.Count > 0)
                {
                    @foreach (var o in lista)
                    {
                        <tr>
                            <td>@o.Numvoucher</td>
                            <td>@o.Fechayhora?.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@o.Unidad</td>
                            <td>@o.Conductor</td>
                            <td>@o.Precio?.ToString("0.00")</td>
                            <td>@o.Preciodesc?.ToString("0.00")</td>
                            <td>@o.Estadoproceso</td>
                        </tr>
                    }
                    <tr class="fw-bold">
                        <td colspan="4">Total</td>
                        <td>@lista.Sum(x => x.Precio ?? 0).ToString("0.00")</td>
                        <td>@lista.Sum(x => x.Preciodesc ?? 0).ToString("0.00")</td>
                        <td></td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="7" class="empty-state">
                            <i class="fas fa-file-invoice"></i>
                            <p>Seleccione una empresa para ver sus vouchers.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<EmpresaDTO> empresas = new();
    private string rucSeleccionado = string.Empty;
    private DateTime? fechaHasta;
    private List<OrdenPagoResumenDTO> lista = new();

    protected override async Task OnInitializedAsync()
    {
        empresas = await empresaRepo.GetEmpresaInfoAll();
    }

    private async Task Buscar()
    {
        if (string.IsNullOrEmpty(rucSeleccionado))
        {
            lista = new();
            return;
        }

        try
        {
            lista = await ordenPagoRepo.GetOrdenPagoPorEmpresa(rucSeleccionado, fechaHasta);
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("Error al cargar la facturación: " + ex.Message);
        }
    }

    private async Task ExportarPdf()
    {
        if (string.IsNullOrEmpty(rucSeleccionado)) return;

        var razonSocial = empresas.FirstOrDefault(e => e.Ruc == rucSeleccionado)?.Razonsocial ?? rucSeleccionado;

        try
        {
            var pdfBytes = await ordenPagoRepo.ExportarFacturacionPdf(rucSeleccionado, razonSocial, fechaHasta);

            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                await displayMessage.DisplayErrorMessage("El PDF generado está vacío.");
                return;
            }

            await JS.InvokeVoidAsync("downloadFileFromByteArray", new
            {
                byteArray = pdfBytes,
                fileName = $"Facturacion_{razonSocial}.pdf",
                contentType = "application/pdf"
            });
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("Error al exportar la facturación: " + ex.Message);
        }
    }
}
