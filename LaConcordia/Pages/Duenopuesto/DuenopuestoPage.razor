@page "/duenopuesto"
@using LaConcordia.Interface
@inject IDuenopuesto duenopuestoRepo
@inject IJSRuntime JS
@using LaConcordia.DTO
@using LaConcordia.Pagination
@inject IDisplayMessage displayMessage

<link href="css/AdminCommon.css" rel="stylesheet" />

<div class="page-container">
    <div class="content-card">
        <div class="header-section">
            <h1 class="page-title">
                <i class="fas fa-user-tie"></i> Gestión de Dueños de Puestos
            </h1>
            <div class="action-buttons">
                <button class="btn-modern btn-secondary-modern" @onclick="ExportarEmpresasPdf">
                    <i class="fas fa-file-pdf"></i> Exportar PDF
                </button>
                <button class="btn-modern btn-primary-modern" @onclick="AbrirModalNuevo">
                    <i class="fas fa-plus"></i> Nuevo Dueño de Puesto
                </button>
            </div>
        </div>

        <div class="d-flex gap-2 mb-3" style="flex-wrap: wrap; align-items: center;">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="Buscar por cédula..." @bind="filtroCedula" @bind:event="oninput" @bind:after="OnFiltroChanged" />
            </div>
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="Buscar por nombre..." @bind="filtroNombre" @bind:event="oninput" @bind:after="OnFiltroChanged" />
            </div>
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="Buscar por apellidos..." @bind="filtroApellidos" @bind:event="oninput" @bind:after="OnFiltroChanged" />
            </div>
            <select class="form-control" style="width: 180px;" @bind="estadoFiltro" @bind:after="OnFiltroChanged">
                <option value="">Todos los Estados</option>
                <option value="a">Activo</option>
                <option value="p">Pasivo</option>
            </select>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2">
            <p class="text-muted mb-0">Total: @TotalRegistros | Página: @PaginaActual</p>
            <Pagination TotalItems="@TotalRegistros"
                        PageSize="@PageSize"
                        CurrentPage="@PaginaActual"
                        OnPageChanged="OnPageChangedAsync" />
        </div>

        <table class="admin-table">
            <thead>
                <tr>
                    <th>Cédula</th>
                    <th>Nombres</th>
                    <th>Apellidos</th>
                    <th style="width: 130px;">Estado</th>
                    <th style="width: 120px; text-align: center;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (duenopuestos is not null && duenopuestos.Count > 0)
                {
                    @foreach (var dp in duenopuestos)
                    {
                        <tr>
                            <td style="color: #7f8c8d;">@dp.Cedula</td>
                            <td><strong>@dp.Nombres</strong></td>
                            <td>@dp.Apellidos</td>
                            <td>
                                @if (dp.Estado == "a")
                                {
                                    <span class="badge-modern badge-success"><i class="fas fa-check-circle"></i> Activo</span>
                                }
                                else
                                {
                                    <span class="badge-modern badge-danger"><i class="fas fa-times-circle"></i> Pasivo</span>
                                }
                            </td>
                            <td>
                                <div class="action-buttons" style="justify-content: center;">
                                    <button class="btn-icon btn-edit" title="Editar" @onclick="() => AbrirModalEditar(dp)">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn-icon btn-delete" title="Eliminar" @onclick="() => Eliminar(dp)">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="empty-state">
                            <i class="fas fa-user-tie"></i>
                            <p>No se encontraron registros.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (showModal)
{
    <div class="modal-modern" @onclick="CerrarModal">
        <div class="modal-content-modern" style="max-width: 480px;" @onclick:stopPropagation="true">
            <div class="modal-header-modern">
                <h2 class="modal-title-modern">
                    <i class="fas @(esNuevo ? "fa-plus" : "fa-edit")"></i>
                    @(esNuevo ? "Nuevo Dueño de Puesto" : "Editar Dueño de Puesto")
                </h2>
                <button type="button" class="btn-close-modern" @onclick="CerrarModal">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="modal-body-modern">
                <div class="form-group">
                    <label class="form-label">Cédula <span class="text-danger">*</span></label>
                    <input class="form-control" @bind="duenopuestoSeleccionado.Cedula" placeholder="Cédula" disabled="@(!esNuevo)" />
                </div>
                <div class="form-group">
                    <label class="form-label">Nombres</label>
                    <input class="form-control" @bind="duenopuestoSeleccionado.Nombres" placeholder="Nombres" />
                </div>
                <div class="form-group">
                    <label class="form-label">Apellidos</label>
                    <input class="form-control" @bind="duenopuestoSeleccionado.Apellidos" placeholder="Apellidos" />
                </div>
                <div class="form-group">
                    <label class="form-label">Estado</label>
                    <select class="form-control" @bind="duenopuestoSeleccionado.Estado">
                        <option value="a">Activo</option>
                        <option value="p">Pasivo</option>
                    </select>
                </div>
            </div>

            <div class="modal-footer-modern">
                <button type="button" class="btn-modern btn-secondary-modern" @onclick="CerrarModal">
                    <i class="fas fa-times"></i> Cancelar
                </button>
                <button type="button" class="btn-modern btn-primary-modern" @onclick="Guardar" disabled="@(!PuedeGuardar)">
                    <i class="fas fa-save"></i> Guardar
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<DuenopuestoDTO> todosLosDuenopuestos = new();
    private List<DuenopuestoDTO> duenopuestos = new();
    private DuenopuestoDTO duenopuestoSeleccionado = new();
    private bool esNuevo = false;
    private bool showModal = false;

    private string filtroCedula = "";
    private string filtroNombre = "";
    private string filtroApellidos = "";
    private string estadoFiltro = "";

    private int PaginaActual = 1;
    private int PageSize = 10;
    private int TotalRegistros = 0;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    // Trae todos los dueños de puesto del servidor una sola vez; el filtro y la
    // paginacion se resuelven despues en memoria, sin volver a golpear la API/BD.
    private async Task CargarAsync()
    {
        try
        {
            todosLosDuenopuestos = await duenopuestoRepo.DuenopuestoInfoAll() ?? new();
            AplicarFiltro();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error al cargar: {ex.Message}");
        }
    }

    private void AplicarFiltro()
    {
        IEnumerable<DuenopuestoDTO> query = todosLosDuenopuestos;

        if (!string.IsNullOrWhiteSpace(filtroCedula))
            query = query.Where(d => d.Cedula != null &&
                d.Cedula.Contains(filtroCedula, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrWhiteSpace(filtroNombre))
            query = query.Where(d => d.Nombres != null &&
                d.Nombres.Contains(filtroNombre, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrWhiteSpace(filtroApellidos))
            query = query.Where(d => d.Apellidos != null &&
                d.Apellidos.Contains(filtroApellidos, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrEmpty(estadoFiltro))
            query = query.Where(d => d.Estado == estadoFiltro);

        var filtrados = query.ToList();
        TotalRegistros = filtrados.Count;

        duenopuestos = filtrados
            .Skip((PaginaActual - 1) * PageSize)
            .Take(PageSize)
            .ToList();
    }

    private void OnFiltroChanged()
    {
        PaginaActual = 1;
        AplicarFiltro();
    }

    private void AbrirModalNuevo()
    {
        duenopuestoSeleccionado = new DuenopuestoDTO { Estado = "a" };
        esNuevo = true;
        showModal = true;
    }

    private void AbrirModalEditar(DuenopuestoDTO dp)
    {
        duenopuestoSeleccionado = new DuenopuestoDTO
            {
                Cedula = dp.Cedula,
                Nombres = dp.Nombres,
                Apellidos = dp.Apellidos,
                Estado = dp.Estado
            };
        esNuevo = false;
        showModal = true;
    }

    private void CerrarModal()
    {
        showModal = false;
        duenopuestoSeleccionado = new();
        esNuevo = false;
    }

    private async Task Guardar()
    {
        try
        {
            if (esNuevo)
                await duenopuestoRepo.InsertDuenopuesto(duenopuestoSeleccionado);
            else
                await duenopuestoRepo.UpdateDuenopuesto(duenopuestoSeleccionado);

            await displayMessage.DisplaySuccessMessage(esNuevo ? "Dueño de puesto creado correctamente." : "Dueño de puesto actualizado correctamente.");
            CerrarModal();
            await CargarAsync();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error al guardar: {ex.Message}");
        }
    }

    private async Task Eliminar(DuenopuestoDTO dp)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", $"¿Está seguro de eliminar a \"{dp.Nombres} {dp.Apellidos}\"?");
        if (confirm)
        {
            await duenopuestoRepo.DeleteDuenopuestoByCedula(dp.Cedula);
            await CargarAsync();
        }
    }

    private void OnPageChangedAsync(int nuevaPagina)
    {
        PaginaActual = nuevaPagina;
        AplicarFiltro();
    }

    //exportar pdf
    private async Task ExportarEmpresasPdf()
    {
        try
        {
            var pdfBytes = await duenopuestoRepo.ObtenerDuenoPuestoFiltradas(filtroCedula, filtroNombre, filtroApellidos, estadoFiltro);

            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                await displayMessage.DisplayErrorMessage("El PDF generado está vacío.");
                return;
            }

            await JS.InvokeVoidAsync("downloadFileFromByteArray", new
            {
                byteArray = pdfBytes,
                fileName = "ListadoDueñoPuesto.pdf",
                contentType = "application/pdf"
            });
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("Error al exportar PDF: " + ex.Message);
        }
    }

    private bool PuedeGuardar => !string.IsNullOrWhiteSpace(duenopuestoSeleccionado.Cedula);
}
