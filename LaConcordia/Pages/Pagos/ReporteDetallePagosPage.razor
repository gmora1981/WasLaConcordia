@page "/reporte-pagos-monitoria"
@using LaConcordia.DTO
@using LaConcordia.Interface
@inject IPagos pagosRepo
@inject IPedido pedidoRepo
@inject IDisplayMessage displayMessage
@inject IJSRuntime JS

<link href="css/AdminCommon.css" rel="stylesheet" />

<div class="page-container">
    <div class="content-card">
        <div class="header-section">
            <h1 class="page-title">
                <i class="fas fa-money-check-alt"></i> Reporte Detalle de Pagos x Monitoria
            </h1>
        </div>

        <div class="d-flex gap-2 mb-3" style="flex-wrap: wrap; align-items: end;">
            <div class="form-group" style="width: 200px; margin-bottom: 0;">
                <label class="form-label">Unidad</label>
                <input class="form-control" list="unidadesList" placeholder="Seleccione..."
                       value="@unidadSeleccionada" @oninput="OnUnidadInput" />
                <datalist id="unidadesList">
                    @foreach (var u in unidades)
                    {
                        <option value="@u">@u</option>
                    }
                </datalist>
            </div>
            <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label">Desde</label>
                <input type="date" class="form-control" @bind="fechaDesde" @bind:after="Buscar" />
            </div>
            <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label">Hasta</label>
                <input type="date" class="form-control" @bind="fechaHasta" @bind:after="Buscar" />
            </div>
            <button class="btn-modern btn-secondary-modern" @onclick="ExportarPdf">
                <i class="fas fa-file-pdf"></i> Exportar PDF
            </button>
        </div>

        @if (string.IsNullOrEmpty(unidadSeleccionada))
        {
            <div class="empty-state">
                <i class="fas fa-money-check-alt"></i>
                <p>Seleccione una unidad para ver sus pagos de cuota semanal.</p>
            </div>
        }
        else
        {
            <p class="text-muted mb-2">Total: @lista.Count | Total Pagado: @lista.Sum(x => x.Valorpagado ?? 0).ToString("0.00")</p>

            <div style="overflow-x: auto;">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Periodo</th>
                            <th>Semana</th>
                            <th>Fecha Pago</th>
                            <th>Valor Pagado</th>
                            <th>Forma de Pago</th>
                            <th>Detalle</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (lista.Count > 0)
                        {
                            @foreach (var p in lista)
                            {
                                <tr>
                                    <td>@p.Periodo</td>
                                    <td>@p.Semana</td>
                                    <td>@p.Fechapago.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                    <td>@p.Valorpagado?.ToString("0.00")</td>
                                    <td>@p.Formadepago</td>
                                    <td>@p.Detalle</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="empty-state">
                                    <i class="fas fa-money-check-alt"></i>
                                    <p>No hay pagos registrados para la unidad y el rango seleccionados.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private List<string> unidades = new();
    private string unidadSeleccionada = string.Empty;
    private DateTime fechaDesde = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime fechaHasta = DateTime.Today;
    private List<DetallePagoMonitoriaDTO> lista = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            unidades = await pedidoRepo.GetUnidadesConPedidos();
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("Error al cargar los filtros: " + ex.Message);
        }
    }

    private async Task OnUnidadInput(ChangeEventArgs e)
    {
        unidadSeleccionada = e.Value?.ToString() ?? "";
        if (unidadSeleccionada == "" || unidades.Contains(unidadSeleccionada))
        {
            await Buscar();
        }
    }

    private async Task Buscar()
    {
        if (string.IsNullOrEmpty(unidadSeleccionada)) return;

        if (fechaDesde > fechaHasta)
        {
            await displayMessage.DisplayErrorMessage("La fecha 'Desde' no puede ser posterior a 'Hasta'.");
            return;
        }

        try
        {
            lista = await pagosRepo.GetDetallePagosPorUnidad(unidadSeleccionada, fechaDesde, fechaHasta);
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("Error al cargar el reporte: " + ex.Message);
        }
    }

    private async Task ExportarPdf()
    {
        if (string.IsNullOrEmpty(unidadSeleccionada))
        {
            await displayMessage.DisplayErrorMessage("Seleccione una unidad antes de exportar.");
            return;
        }

        try
        {
            var pdfBytes = await pagosRepo.ExportarReporteDetallePagosPdf(unidadSeleccionada, fechaDesde, fechaHasta);

            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                await displayMessage.DisplayErrorMessage("El PDF generado está vacío.");
                return;
            }

            await JS.InvokeVoidAsync("downloadFileFromByteArray", new
            {
                byteArray = pdfBytes,
                fileName = "ReporteDetallePagosMonitoria.pdf",
                contentType = "application/pdf"
            });
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("Error al exportar el reporte: " + ex.Message);
        }
    }
}
