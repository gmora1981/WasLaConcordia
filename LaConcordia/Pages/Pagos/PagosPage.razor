@page "/cobros-monitoria"
@using LaConcordia.DTO
@using LaConcordia.Interface
@using LaConcordia.Pagination
@inject IPagos pagosRepo
@inject IFichapersonal fichaRepo
@inject IDisplayMessage displayMessage

<link href="css/AdminCommon.css" rel="stylesheet" />

<div class="page-container">
    <div class="content-card">
        <div class="header-section">
            <h1 class="page-title">
                <i class="fas fa-hand-holding-usd"></i> Cobros de Monitoria
            </h1>
        </div>

        <div class="d-flex gap-2 mb-3" style="flex-wrap: wrap; align-items: end;">
            <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label">Estado</label>
                <select class="form-control" style="width: 160px;" @bind="estadoFiltro" @bind:after="BuscarListado">
                    <option value="a">Activo</option>
                    <option value="p">Pasivo</option>
                </select>
            </div>
            <div class="search-box" style="flex-grow: 1; min-width: 220px;">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="Búsqueda por Unidad..."
                       @bind="unidadFiltro" @bind:event="oninput" @bind:after="BuscarListado" />
            </div>
            <div class="search-box" style="flex-grow: 1; min-width: 220px;">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="Búsqueda por Apellido..."
                       @bind="apellidoFiltro" @bind:event="oninput" @bind:after="BuscarListado" />
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2">
            <p class="text-muted mb-0">Total: @TotalSocios | Página: @PaginaActual</p>
            <Pagination TotalItems="@TotalSocios"
                        PageSize="@PageSize"
                        CurrentPage="@PaginaActual"
                        OnPageChanged="OnPageChangedAsync" />
        </div>

        <div style="overflow-x: auto;">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Cédula</th>
                        <th>Nombre</th>
                        <th>Apellidos</th>
                        <th>Celular</th>
                        <th>Unidad</th>
                    </tr>
                </thead>
                <tbody>
                    @if (socios.Count > 0)
                    {
                        @foreach (var s in socios)
                        {
                            <tr @onclick="() => SeleccionarSocio(s)"
                                class="@(deuda?.Cedula == s.Cedula ? "table-primary" : "")"
                                style="cursor: pointer;">
                                <td>@s.Cedula</td>
                                <td><strong>@s.Nombre</strong></td>
                                <td>@s.Apellidos</td>
                                <td>@s.Celular</td>
                                <td>@s.Fkunidad</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="empty-state">
                                <p>No se encontraron socios.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>

@if (showModal && deuda != null)
{
    <div class="modal-modern" @onclick="CerrarModal">
        <div class="modal-content-modern" style="max-width: 1100px; width: 95%; max-height: 92vh; overflow-y: auto;" @onclick:stopPropagation="true">
            <div class="modal-header-modern">
                <h2 class="modal-title-modern">
                    <i class="fas fa-hand-holding-usd"></i> @deuda.Apellidos @deuda.Nombre — C.I. @deuda.Cedula
                </h2>
                <button type="button" class="btn-close-modern" @onclick="CerrarModal">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="modal-body-modern">
                <p class="fw-bold">Total a pagar: <span class="badge-modern badge-danger">@deuda.TotalAPagar.ToString("0.00")</span></p>

                <div class="row">
                    <div class="col-md-6">
                        <h6>Cuota Semanal (Total: @deuda.TotalCuota.ToString("0.00"))</h6>
                        <table class="admin-table">
                            <thead><tr><th>Período</th><th>Semana</th><th>Valor</th><th>Saldo</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var c in deuda.CuotasPendientes)
                                {
                                    <tr>
                                        <td>@c.Periodo</td>
                                        <td>@c.Semana</td>
                                        <td>@c.Valor?.ToString("0.00")</td>
                                        <td>@((c.Valor - c.Abono)?.ToString("0.00"))</td>
                                        <td><button class="btn-icon btn-edit" title="Pagar" @onclick="() => SeleccionarCuota(c)"><i class="fas fa-dollar-sign"></i></button></td>
                                    </tr>
                                }
                                @if (deuda.CuotasPendientes.Count == 0)
                                {
                                    <tr><td colspan="5" class="empty-state"><p>Sin pendientes</p></td></tr>
                                }
                            </tbody>
                        </table>

                        <h6>Multas (Total: @deuda.TotalMulta.ToString("0.00"))</h6>
                        <table class="admin-table">
                            <thead><tr><th>ID</th><th>Tipo</th><th>Valor</th><th>Saldo</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var m in deuda.MultasPendientes)
                                {
                                    <tr>
                                        <td>@m.Idmulta</td>
                                        <td>@m.Tipo</td>
                                        <td>@m.Valor?.ToString("0.00")</td>
                                        <td>@((m.Valor - m.Abono)?.ToString("0.00"))</td>
                                        <td><button class="btn-icon btn-edit" title="Pagar" @onclick='() => SeleccionarUbm(m.Idmulta, "M", m.Valor, m.Abono, $"Multa {m.Idmulta}")'><i class="fas fa-dollar-sign"></i></button></td>
                                    </tr>
                                }
                                @if (deuda.MultasPendientes.Count == 0)
                                {
                                    <tr><td colspan="5" class="empty-state"><p>Sin pendientes</p></td></tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="col-md-6">
                        <h6>Plan Ayuda (Total: @deuda.TotalPlanAyuda.ToString("0.00"))</h6>
                        <table class="admin-table">
                            <thead><tr><th>Beneficiario</th><th>Valor</th><th>Saldo</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var p in deuda.PlanAyudaPendientes)
                                {
                                    <tr>
                                        <td>@p.Beneficiario</td>
                                        <td>@p.Valor?.ToString("0.00")</td>
                                        <td>@((p.Valor - p.Abono)?.ToString("0.00"))</td>
                                        <td><button class="btn-icon btn-edit" title="Pagar" @onclick='() => SeleccionarUbm(p.Beneficiario, "B", p.Valor, p.Abono, $"Plan Ayuda {p.Beneficiario}")'><i class="fas fa-dollar-sign"></i></button></td>
                                    </tr>
                                }
                                @if (deuda.PlanAyudaPendientes.Count == 0)
                                {
                                    <tr><td colspan="4" class="empty-state"><p>Sin pendientes</p></td></tr>
                                }
                            </tbody>
                        </table>

                        <h6>Plan Choque (Total: @deuda.TotalPlanChoque.ToString("0.00"))</h6>
                        <table class="admin-table">
                            <thead><tr><th>Unidad</th><th>Valor</th><th>Saldo</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var p in deuda.PlanChoquePendientes)
                                {
                                    <tr>
                                        <td>@p.Unidad</td>
                                        <td>@p.Valor?.ToString("0.00")</td>
                                        <td>@((p.Valor - p.Abono)?.ToString("0.00"))</td>
                                        <td><button class="btn-icon btn-edit" title="Pagar" @onclick='() => SeleccionarUbm(p.Unidad, "U", p.Valor, p.Abono, $"Plan Choque {p.Unidad}")'><i class="fas fa-dollar-sign"></i></button></td>
                                    </tr>
                                }
                                @if (deuda.PlanChoquePendientes.Count == 0)
                                {
                                    <tr><td colspan="4" class="empty-state"><p>Sin pendientes</p></td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @if (pagoActivo)
                {
                    <div class="content-card" style="max-width: 500px; margin: 1rem 0 0 0; box-shadow: none; border: 1px solid #e5e7eb;">
                        <h5>Registrar pago — @concepto</h5>
                        <p>Saldo: <strong>@saldo.ToString("0.00")</strong></p>

                        <div class="form-group">
                            <label class="form-label">Forma de pago</label>
                            <select class="form-control" @bind="formaDePago" @bind:after="OnFormaDePagoChanged">
                                <option value="">-- Seleccione --</option>
                                <option value="EFECTIVO">Efectivo</option>
                                <option value="EXONERACION">Exoneración</option>
                                <option value="INACTIVO">Inactivo</option>
                                <option value="BANCO GUAYAQUIL">Banco Guayaquil</option>
                                <option value="BANCO PICHINCHA">Banco Pichincha</option>
                                <option value="BANCO DEL PACIFICO">Banco del Pacífico</option>
                                <option value="COMISION">Comisión</option>
                                <option value="CUENTAXCOBRAR">Cuenta x Cobrar</option>
                            </select>
                        </div>

                        @if (RequiereComprobante)
                        {
                            <div class="form-group">
                                <label class="form-label">Número de comprobante</label>
                                <input class="form-control" @bind="numComprobante" />
                            </div>
                            <button class="btn-modern btn-secondary-modern mb-2" @onclick="Validar" disabled="@string.IsNullOrWhiteSpace(numComprobante)">
                                <i class="fas fa-check"></i> Validar
                            </button>
                            @if (comprobanteValidado)
                            {
                                <p style="color:#16a34a;">Comprobante válido.</p>
                            }
                        }

                        <div class="form-group">
                            <label class="form-label">Valor a pagar</label>
                            <input class="form-control" type="number" step="0.01" min="0" @bind="valorAPagar" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">Detalle</label>
                            <input class="form-control" @bind="detalle" />
                        </div>

                        <div class="action-buttons mt-2">
                            <button class="btn-modern btn-primary-modern" @onclick="Guardar" disabled="@(!PuedeGuardar)">
                                <i class="fas fa-save"></i> Guardar
                            </button>
                            <button class="btn-modern btn-secondary-modern" @onclick="CancelarPago">
                                <i class="fas fa-times"></i> Cancelar
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    // Grilla de socios (filtros + paginación)
    private List<FichapersonalDTO> socios = new();
    private string estadoFiltro = "a";
    private string unidadFiltro = string.Empty;
    private string apellidoFiltro = string.Empty;
    private int PaginaActual = 1;
    private int PageSize = 10;
    private int TotalSocios = 0;

    private DeudaSocioDTO? deuda;
    private bool showModal = false;

    // Item seleccionado para pago
    private bool pagoActivo = false;
    private string tipoPago = string.Empty; // "CUOTA", "M", "B", "U"
    private string concepto = string.Empty;
    private string? periodoSel, semanaSel, ubmSel;
    private decimal saldo;

    private string formaDePago = string.Empty;
    private string numComprobante = string.Empty;
    private bool comprobanteValidado = false;
    private decimal? valorAPagar;
    private string detalle = string.Empty;

    private bool RequiereComprobante => !string.IsNullOrEmpty(formaDePago)
        && formaDePago != "EFECTIVO" && formaDePago != "EXONERACION" && formaDePago != "INACTIVO";

    private bool PuedeGuardar => !string.IsNullOrEmpty(formaDePago) && valorAPagar.HasValue && valorAPagar.Value > 0
        && (!RequiereComprobante || comprobanteValidado);

    protected override async Task OnInitializedAsync()
    {
        await BuscarListado();
    }

    private async Task CargarListadoAsync()
    {
        var resultado = await fichaRepo.GetFichaPersonalPaginados(
            PaginaActual, PageSize, null, estadoFiltro, null, unidadFiltro, apellidoFiltro);
        socios = resultado.Items;
        TotalSocios = resultado.TotalItems;
    }

    private async Task BuscarListado()
    {
        PaginaActual = 1;
        await CargarListadoAsync();
    }

    private async Task OnPageChangedAsync(int nuevaPagina)
    {
        PaginaActual = nuevaPagina;
        await CargarListadoAsync();
    }

    private async Task SeleccionarSocio(FichapersonalDTO ficha)
    {
        try
        {
            deuda = await pagosRepo.GetDeudaSocio(ficha.Cedula);
            if (deuda == null)
            {
                await displayMessage.DisplayErrorMessage("No se encontró la deuda de este socio.");
                return;
            }
            pagoActivo = false;
            showModal = true;
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("Error al consultar la deuda: " + ex.Message);
        }
    }

    private void CerrarModal()
    {
        showModal = false;
        pagoActivo = false;
    }

    private void SeleccionarCuota(GenerarCuotaDTO c)
    {
        tipoPago = "CUOTA";
        periodoSel = c.Periodo;
        semanaSel = c.Semana;
        ubmSel = null;
        concepto = $"Cuota semanal {c.Periodo} - Semana {c.Semana}";
        saldo = (c.Valor ?? 0) - (c.Abono ?? 0);
        AbrirPanelPago();
    }

    private void SeleccionarUbm(string ubm, string tipo, decimal? valor, decimal? abono, string descripcion)
    {
        tipoPago = tipo;
        ubmSel = ubm;
        periodoSel = null;
        semanaSel = null;
        concepto = descripcion;
        saldo = (valor ?? 0) - (abono ?? 0);
        AbrirPanelPago();
    }

    private void AbrirPanelPago()
    {
        formaDePago = string.Empty;
        numComprobante = string.Empty;
        comprobanteValidado = false;
        valorAPagar = null;
        detalle = string.Empty;
        pagoActivo = true;
    }

    private void CancelarPago()
    {
        pagoActivo = false;
    }

    private void OnFormaDePagoChanged()
    {
        comprobanteValidado = false;
        numComprobante = string.Empty;
    }

    private async Task Validar()
    {
        try
        {
            var existe = await pagosRepo.ExisteComprobante(formaDePago, numComprobante);
            if (existe)
            {
                await displayMessage.DisplayErrorMessage("El comprobante ya existe.");
                comprobanteValidado = false;
            }
            else
            {
                comprobanteValidado = true;
            }
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("Error al validar el comprobante: " + ex.Message);
        }
    }

    private async Task Guardar()
    {
        if (deuda == null || !valorAPagar.HasValue) return;

        try
        {
            if (tipoPago == "CUOTA")
            {
                await pagosRepo.PagarCuota(new PagoCuotaRequestDTO
                    {
                        Periodo = periodoSel!,
                        Semana = semanaSel!,
                        Cidentidad = deuda.Cedula,
                        ValorAPagar = valorAPagar.Value,
                        FormaDePago = formaDePago,
                        Banco = formaDePago,
                        NumComprobante = RequiereComprobante ? numComprobante : null,
                        Detalle = detalle
                    });
            }
            else
            {
                await pagosRepo.PagarUbm(new PagoUbmRequestDTO
                    {
                        Ubm = ubmSel!,
                        Tipo = tipoPago,
                        Cidentidad = deuda.Cedula,
                        ValorAPagar = valorAPagar.Value,
                        FormaDePago = formaDePago,
                        Banco = formaDePago,
                        NumComprobante = RequiereComprobante ? numComprobante : null,
                        Detalle = detalle
                    });
            }

            await displayMessage.DisplaySuccessMessage("Movimiento guardado con éxito.");
            pagoActivo = false;
            deuda = await pagosRepo.GetDeudaSocio(deuda.Cedula);
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("Error al guardar el pago: " + ex.Message);
        }
    }
}
