@page "/generar-multa"
@using LaConcordia.DTO
@using LaConcordia.Interface
@inject IGenerarMulta generarMultaRepo
@inject IFichapersonal fichaRepo
@inject IDisplayMessage displayMessage

<link href="css/AdminCommon.css" rel="stylesheet" />

<div class="page-container">
    <div class="content-card">
        <div class="header-section">
            <h1 class="page-title">
                <i class="fas fa-gavel"></i> Generar Multa
            </h1>
        </div>

        <div class="d-flex gap-2 mb-3" style="max-width: 700px; align-items: end;">
            <div class="search-box" style="flex-grow: 1; position: relative;">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="Cédula, nombre o apellido del socio..."
                       @bind="busqueda" @bind:event="oninput" @bind:after="BuscarSugerencias"
                       @onfocus="() => mostrarSugerencias = sugerencias.Count > 0"
                       @onblur="OcultarSugerenciasConDelay" />

                @if (mostrarSugerencias)
                {
                    <div class="autocomplete-dropdown">
                        @if (sugerencias.Count > 0)
                        {
                            @foreach (var s in sugerencias)
                            {
                                <div class="autocomplete-item" @onclick="() => SeleccionarSugerencia(s)">
                                    <strong>@s.Cedula</strong> — @s.Apellidos @s.Nombre
                                </div>
                            }
                        }
                        else
                        {
                            <div class="autocomplete-item autocomplete-empty">No se encontraron socios.</div>
                        }
                    </div>
                }
            </div>
        </div>

        @if (socio != null)
        {
            <p><strong>@socio.Apellidos @socio.Nombre</strong> — C.I. @socio.Cedula</p>

            <div class="content-card" style="max-width: 500px; margin: 0 0 1.5rem 0; box-shadow: none; border: 1px solid #e5e7eb;">
                <div class="form-group">
                    <label class="form-label">Tipo de multa</label>
                    <select class="form-control" @bind="tipo">
                        <option value="">-- Seleccione --</option>
                        <option value="INASISTENCIA">Inasistencia</option>
                        <option value="DISCIPLINARIA">Disciplinaria</option>
                        <option value="OTRA">Otra</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Valor</label>
                    <input class="form-control" type="number" step="0.01" min="0" @bind="valor" />
                </div>

                <div class="form-group">
                    <label class="form-label">Observación</label>
                    <textarea class="form-control" @bind="observacion"></textarea>
                </div>

                <button class="btn-modern btn-primary-modern" @onclick="Generar" disabled="@(!PuedeGenerar)">
                    <i class="fas fa-play"></i> Generar
                </button>
            </div>

            <h5>Multas registradas</h5>
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Fecha</th>
                        <th>Tipo</th>
                        <th>Valor</th>
                        <th>Abono</th>
                        <th>Saldo</th>
                        <th>Observación</th>
                    </tr>
                </thead>
                <tbody>
                    @if (historial.Count > 0)
                    {
                        @foreach (var m in historial)
                        {
                            <tr>
                                <td>@m.Idmulta</td>
                                <td>@m.Fecha.ToString("dd/MM/yyyy")</td>
                                <td>@m.Tipo</td>
                                <td>@m.Valor?.ToString("0.00")</td>
                                <td>@m.Abono?.ToString("0.00")</td>
                                <td><strong>@((m.Valor - m.Abono)?.ToString("0.00"))</strong></td>
                                <td>@m.Observacion</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="empty-state">
                                <p>Sin multas registradas.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<style>
    .autocomplete-dropdown {
        position: absolute;
        top: calc(100% + 4px);
        left: 0;
        right: 0;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.12);
        max-height: 260px;
        overflow-y: auto;
        z-index: 1050;
    }

    .autocomplete-item {
        padding: 0.6rem 0.9rem;
        cursor: pointer;
        font-size: 0.9rem;
        color: #1f2937;
    }

        .autocomplete-item:hover {
            background: #f0f1f5;
        }

    .autocomplete-empty {
        cursor: default;
        color: #6c757d;
        font-style: italic;
    }

        .autocomplete-empty:hover {
            background: transparent;
        }
</style>

@code {
    private string busqueda = string.Empty;
    private List<FichapersonalDTO> sugerencias = new();
    private bool mostrarSugerencias = false;
    private CancellationTokenSource? busquedaCts;

    private FichapersonalDTO? socio;
    private List<GenerarMultaDTO> historial = new();

    private string tipo = string.Empty;
    private decimal? valor;
    private string observacion = string.Empty;

    private bool PuedeGenerar => !string.IsNullOrEmpty(tipo) && valor.HasValue && valor.Value > 0;

    private async Task BuscarSugerencias()
    {
        busquedaCts?.Cancel();

        if (string.IsNullOrWhiteSpace(busqueda) || busqueda.Trim().Length < 2)
        {
            sugerencias.Clear();
            mostrarSugerencias = false;
            return;
        }

        var cts = new CancellationTokenSource();
        busquedaCts = cts;

        try
        {
            await Task.Delay(300, cts.Token); // debounce: espera a que el usuario deje de escribir

            var resultado = await fichaRepo.GetFichaPersonalPaginados(1, 8, busqueda.Trim(), null);
            if (cts.IsCancellationRequested) return;

            sugerencias = resultado.Items;
            mostrarSugerencias = true;
        }
        catch (TaskCanceledException)
        {
            // el usuario siguió escribiendo antes de que venciera el debounce; se ignora
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("Error al buscar el socio: " + ex.Message);
        }
    }

    private async Task SeleccionarSugerencia(FichapersonalDTO ficha)
    {
        socio = ficha;
        busqueda = $"{ficha.Cedula} — {ficha.Apellidos} {ficha.Nombre}";
        sugerencias.Clear();
        mostrarSugerencias = false;
        await CargarHistorial();
    }

    private async Task OcultarSugerenciasConDelay()
    {
        // pequeño retardo para que el click sobre un item del dropdown alcance a registrarse
        // antes de que el blur del input lo oculte
        await Task.Delay(200);
        mostrarSugerencias = false;
    }

    private async Task CargarHistorial()
    {
        if (socio == null) return;
        historial = await generarMultaRepo.GetMultasPorSocio(socio.Cedula);
    }

    private async Task Generar()
    {
        if (socio == null) return;

        try
        {
            var nueva = new GenerarMultaDTO
                {
                    Cidentidad = socio.Cedula,
                    Tipo = tipo,
                    Valor = valor,
                    Observacion = observacion
                };

            await generarMultaRepo.InsertGenerarMulta(nueva);
            await displayMessage.DisplaySuccessMessage("El registro se guardó con éxito.");

            tipo = string.Empty;
            valor = null;
            observacion = string.Empty;
            await CargarHistorial();
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("Error al generar la multa: " + ex.Message);
        }
    }
}
