@page "/estadocivil"
@using LaConcordia.DTO
@using LaConcordia.Interface
@using LaConcordia.Pagination
@inject IEstadoCivil estadoCivilRepo
@inject IJSRuntime JS
@inject IDisplayMessage displayMessage

<link href="css/AdminCommon.css" rel="stylesheet" />

<div class="page-container">
    <div class="content-card">
        <div class="header-section">
            <h1 class="page-title">
                <i class="fas fa-venus-mars"></i> Gestión de Estado Civil
            </h1>
            <button class="btn-modern btn-primary-modern" @onclick="AbrirModalNuevo">
                <i class="fas fa-plus"></i> Nuevo Estado Civil
            </button>
        </div>

        <div class="d-flex gap-2 mb-3" style="flex-wrap: wrap; align-items: center;">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="Buscar por descripción..." @bind="razonBusqueda" @bind:event="oninput" @bind:after="OnFiltroChanged" />
            </div>
            <select class="form-control" style="width: 180px;" @bind="estadoFiltro" @bind:after="OnFiltroChanged">
                <option value="">Todos los Estados</option>
                <option value="a">Activo</option>
                <option value="p">Pasivo</option>
            </select>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2">
            <p class="text-muted mb-0">Total: @TotalRegistros | Página: @PaginaActual</p>
            <Pagination TotalItems="@TotalRegistros"
                        PageSize="@PageSize"
                        CurrentPage="@PaginaActual"
                        OnPageChanged="OnPageChangedAsync" />
        </div>

        <table class="admin-table">
            <thead>
                <tr>
                    <th style="width: 70px;">#</th>
                    <th>Descripción</th>
                    <th style="width: 130px;">Estado</th>
                    <th style="width: 120px; text-align: center;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (estadocivil != null && estadocivil.Count > 0)
                {
                    @foreach (var estado in estadocivil)
                    {
                        <tr>
                            <td style="color: #7f8c8d;">@estado.Idestadocivil</td>
                            <td><strong>@estado.Descripcion</strong></td>
                            <td>
                                @if (estado.Estado == "a")
                                {
                                    <span class="badge-modern badge-success"><i class="fas fa-check-circle"></i> Activo</span>
                                }
                                else
                                {
                                    <span class="badge-modern badge-danger"><i class="fas fa-times-circle"></i> Pasivo</span>
                                }
                            </td>
                            <td>
                                <div class="action-buttons" style="justify-content: center;">
                                    <button class="btn-icon btn-edit" title="Editar" @onclick="() => AbrirModalEditar(estado)">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn-icon btn-delete" title="Eliminar" @onclick="() => EliminarEstadoCivil(estado)">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="empty-state">
                            <i class="fas fa-venus-mars"></i>
                            <p>No se encontraron estados civiles.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (showModal)
{
    <div class="modal-modern" @onclick="CerrarModal">
        <div class="modal-content-modern" style="max-width: 480px;" @onclick:stopPropagation="true">
            <div class="modal-header-modern">
                <h2 class="modal-title-modern">
                    <i class="fas @(esNuevo ? "fa-plus" : "fa-edit")"></i>
                    @(esNuevo ? "Nuevo Estado Civil" : "Editar Estado Civil")
                </h2>
                <button type="button" class="btn-close-modern" @onclick="CerrarModal">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="modal-body-modern">
                <div class="form-group">
                    <label class="form-label">Descripción <span class="text-danger">*</span></label>
                    <input class="form-control" @bind="estadoCivilSeleccionado.Descripcion" placeholder="Descripción" @ref="inputDescripcionRef" />
                </div>
                <div class="form-group">
                    <label class="form-label">Estado</label>
                    <select class="form-control" @bind="estadoCivilSeleccionado.Estado">
                        <option value="a">Activo</option>
                        <option value="p">Pasivo</option>
                    </select>
                </div>
            </div>

            <div class="modal-footer-modern">
                <button type="button" class="btn-modern btn-secondary-modern" @onclick="CerrarModal">
                    <i class="fas fa-times"></i> Cancelar
                </button>
                <button type="button" class="btn-modern btn-primary-modern" @onclick="GuardarCambios" disabled="@(!PuedeGuardar)">
                    <i class="fas fa-save"></i> Guardar
                </button>
            </div>
        </div>
    </div>
}

@code {
    // Referencia para dar focus al primer input
    private ElementReference inputDescripcionRef;

    private List<EstadoCivilDTO> todosLosEstadoCivil = new();
    private List<EstadoCivilDTO> estadocivil = new();
    private EstadoCivilDTO estadoCivilSeleccionado = new();

    private string razonBusqueda = string.Empty;
    private string estadoFiltro = string.Empty;

    private int PaginaActual = 1;
    private int PageSize = 8;
    private int TotalRegistros = 0;

    private bool esNuevo = false;
    private bool showModal = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarEstadoCivilAsync();
    }

    // Trae todos los estados civiles del servidor una sola vez; el filtro y la
    // paginacion se resuelven despues en memoria, sin volver a golpear la API/BD.
    private async Task CargarEstadoCivilAsync()
    {
        try
        {
            todosLosEstadoCivil = await estadoCivilRepo.GetEstadoCivilAll() ?? new();
            AplicarFiltro();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error al cargar estados civiles: {ex.Message}");
        }
    }

    private void AplicarFiltro()
    {
        IEnumerable<EstadoCivilDTO> query = todosLosEstadoCivil;

        if (!string.IsNullOrWhiteSpace(razonBusqueda))
            query = query.Where(e => e.Descripcion != null &&
                e.Descripcion.Contains(razonBusqueda, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrEmpty(estadoFiltro))
            query = query.Where(e => e.Estado == estadoFiltro);

        var filtrados = query.ToList();
        TotalRegistros = filtrados.Count;

        estadocivil = filtrados
            .Skip((PaginaActual - 1) * PageSize)
            .Take(PageSize)
            .ToList();
    }

    private void OnFiltroChanged()
    {
        PaginaActual = 1;
        AplicarFiltro();
    }

    private void AbrirModalNuevo()
    {
        estadoCivilSeleccionado = new EstadoCivilDTO { Estado = "a" };
        esNuevo = true;
        showModal = true;
    }

    private void AbrirModalEditar(EstadoCivilDTO estado)
    {
        estadoCivilSeleccionado = new EstadoCivilDTO
            {
                Idestadocivil = estado.Idestadocivil,
                Descripcion = estado.Descripcion,
                Estado = estado.Estado
            };
        esNuevo = false;
        showModal = true;
    }

    private void CerrarModal()
    {
        showModal = false;
        estadoCivilSeleccionado = new EstadoCivilDTO();
        esNuevo = false;
    }

    private async Task GuardarCambios()
    {
        try
        {
            if (esNuevo)
                await estadoCivilRepo.InsertEstadoCivil(estadoCivilSeleccionado);
            else
                await estadoCivilRepo.UpdateEstadoCivil(estadoCivilSeleccionado);

            await displayMessage.DisplaySuccessMessage(esNuevo ? "Estado civil creado correctamente." : "Estado civil actualizado correctamente.");
            CerrarModal();
            await CargarEstadoCivilAsync();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error al guardar: {ex.Message}");
        }
    }

    private async Task EliminarEstadoCivil(EstadoCivilDTO estado)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", $"¿Estás seguro de eliminar \"{estado.Descripcion}\"?");
        if (confirm)
        {
            await estadoCivilRepo.DeleteEstadoCivilById(estado.Idestadocivil);
            await CargarEstadoCivilAsync();
        }
    }

    private void OnPageChangedAsync(int nuevaPagina)
    {
        PaginaActual = nuevaPagina;
        AplicarFiltro();
    }

    private bool PuedeGuardar => !string.IsNullOrWhiteSpace(estadoCivilSeleccionado.Descripcion);
}
