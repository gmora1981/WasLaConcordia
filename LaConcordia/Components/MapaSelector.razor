@using LaConcordia.DTO
@using LaConcordia.Interface
@inject IGeocoding geocodingRepo
@inject IJSRuntime JS
@inject IDisplayMessage displayMessage
@implements IAsyncDisposable

<div class="mapa-selector">
    <div class="mb-2" style="position: relative;">
        <input class="form-control" placeholder="Escribe una calle o dirección..."
               @bind="textoBusqueda" @bind:event="oninput" @bind:after="BuscarSugerencias"
               @onkeydown="OnKeyDown"
               @onfocus="() => mostrarSugerencias = predicciones.Count > 0"
               @onblur="OcultarSugerenciasConDelay" />

        @if (buscando)
        {
            <div class="mapa-buscando">Buscando…</div>
        }
        else if (mostrarSugerencias && predicciones.Count > 0)
        {
            <ul class="mapa-autocomplete-dropdown">
                @foreach (var p in predicciones)
                {
                    <li @onclick="() => SeleccionarPrediccion(p)">
                        <i class="fas fa-map-marker-alt"></i> @p.Description
                    </li>
                }
            </ul>
        }
    </div>

    <div id="@mapaId" style="height:@Height; border-radius: 4px; border: 1px solid #ccc;"></div>

    <p class="text-muted mt-1 mb-0" style="font-size: 0.8rem;">
        Lat: @Lat.ToString("0.000000") — Lng: @Lng.ToString("0.000000")
        (haga clic en el mapa o arrastre el marcador para fijar el punto)
    </p>
</div>

<style>
    .mapa-autocomplete-dropdown {
        position: absolute;
        top: calc(100% + 4px);
        left: 0;
        right: 0;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.12);
        max-height: 220px;
        overflow-y: auto;
        z-index: 1050;
        list-style: none;
        margin: 0;
        padding: 0.25rem 0;
    }

        .mapa-autocomplete-dropdown li {
            padding: 0.5rem 0.75rem;
            cursor: pointer;
            font-size: 0.85rem;
            color: #1f2937;
        }

            .mapa-autocomplete-dropdown li:hover {
                background: #f0f1f5;
            }

            .mapa-autocomplete-dropdown li i {
                color: #6c757d;
                margin-right: 0.35rem;
            }

    .mapa-buscando {
        position: absolute;
        top: calc(100% + 4px);
        left: 0;
        right: 0;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.12);
        padding: 0.5rem 0.75rem;
        font-size: 0.85rem;
        color: #6c757d;
        font-style: italic;
        z-index: 1050;
    }
</style>

@code {
    [Parameter] public decimal Lat { get; set; }
    [Parameter] public EventCallback<decimal> LatChanged { get; set; }

    [Parameter] public decimal Lng { get; set; }
    [Parameter] public EventCallback<decimal> LngChanged { get; set; }

    [Parameter] public EventCallback OnCoordenadasChanged { get; set; }

    [Parameter] public string Height { get; set; } = "300px";

    private readonly string mapaId = "mapa_" + Guid.NewGuid().ToString("N");
    private DotNetObjectReference<MapaSelector>? dotNetRef;
    private bool mapaIniciado = false;

    private string textoBusqueda = string.Empty;
    private List<PlacePredictionDTO> predicciones = new();
    private bool mostrarSugerencias = false;
    private bool buscando = false;
    private CancellationTokenSource? busquedaCts;

    // Coordenada por defecto: Guayaquil, Ecuador (ciudad donde opera la cooperativa).
    private const decimal LatPorDefecto = -2.1709979m;
    private const decimal LngPorDefecto = -79.9223592m;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            var sinCoordenadas = Lat == 0 && Lng == 0;
            var latInicial = Lat != 0 ? Lat : LatPorDefecto;
            var lngInicial = Lng != 0 ? Lng : LngPorDefecto;
            var zoomInicial = (Lat != 0 && Lng != 0) ? 16 : 13;

            await JS.InvokeVoidAsync("leafletInterop.iniciar", mapaId, dotNetRef, latInicial, lngInicial, zoomInicial);
            mapaIniciado = true;

            // El fallback de arriba solo centraba el mapa visualmente; si no se sincroniza
            // tambien Lat/Lng (y se notifica al padre), guardar sin tocar el mapa grababa
            // 0,0 (el "Null Island" frente a Africa) en vez de la posicion realmente mostrada.
            if (sinCoordenadas)
            {
                Lat = latInicial;
                Lng = lngInicial;
                await LatChanged.InvokeAsync(Lat);
                await LngChanged.InvokeAsync(Lng);
                await OnCoordenadasChanged.InvokeAsync();
            }
        }
    }

    [JSInvokable]
    public async Task OnCoordenadasSeleccionadas(double lat, double lng)
    {
        Lat = (decimal)lat;
        Lng = (decimal)lng;
        await LatChanged.InvokeAsync(Lat);
        await LngChanged.InvokeAsync(Lng);
        await OnCoordenadasChanged.InvokeAsync();
        StateHasChanged();
    }

    private async Task BuscarSugerencias()
    {
        busquedaCts?.Cancel();

        if (string.IsNullOrWhiteSpace(textoBusqueda) || textoBusqueda.Trim().Length < 3)
        {
            predicciones.Clear();
            mostrarSugerencias = false;
            buscando = false;
            return;
        }

        var cts = new CancellationTokenSource();
        busquedaCts = cts;
        buscando = true;

        try
        {
            await Task.Delay(400, cts.Token); // debounce: espera a que el usuario deje de escribir
            var encontradas = await geocodingRepo.BuscarPredicciones(textoBusqueda.Trim());
            if (cts.IsCancellationRequested) return;

            predicciones = encontradas;
            mostrarSugerencias = true;
        }
        catch (TaskCanceledException)
        {
            // el usuario siguió escribiendo antes de que venciera el debounce; se ignora
        }
        catch (Exception ex)
        {
            await displayMessage.DisplayErrorMessage("No se pudo buscar la dirección: " + ex.Message);
        }
        finally
        {
            if (!cts.IsCancellationRequested)
                buscando = false;
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && predicciones.Count > 0)
        {
            await SeleccionarPrediccion(predicciones[0]);
        }
    }

    private async Task OcultarSugerenciasConDelay()
    {
        // pequeño retardo para que el click sobre una sugerencia alcance a registrarse
        // antes de que el blur del input la oculte
        await Task.Delay(200);
        mostrarSugerencias = false;
    }

    private async Task SeleccionarPrediccion(PlacePredictionDTO p)
    {
        textoBusqueda = p.Description;
        predicciones.Clear();
        mostrarSugerencias = false;
        buscando = true;

        GeocodingResultDTO? resultado;
        try
        {
            resultado = await geocodingRepo.ObtenerCoordenadasPorPlaceId(p.PlaceId);
        }
        catch (Exception ex)
        {
            buscando = false;
            await displayMessage.DisplayErrorMessage("No se pudo ubicar esa dirección: " + ex.Message);
            return;
        }
        buscando = false;

        if (resultado == null)
        {
            await displayMessage.DisplayErrorMessage("No se encontraron coordenadas para esa dirección.");
            return;
        }

        Lat = resultado.Lat;
        Lng = resultado.Lon;

        await LatChanged.InvokeAsync(Lat);
        await LngChanged.InvokeAsync(Lng);
        await OnCoordenadasChanged.InvokeAsync();

        if (mapaIniciado)
        {
            await JS.InvokeVoidAsync("leafletInterop.moverMarcador", mapaId, (double)Lat, (double)Lng, 17);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (mapaIniciado)
        {
            try
            {
                await JS.InvokeVoidAsync("leafletInterop.destruir", mapaId);
            }
            catch (JSDisconnectedException)
            {
                // La conexion de circuito ya se cerro (navegacion fuera de la pagina); nada que limpiar.
            }
        }
        dotNetRef?.Dispose();
    }
}
